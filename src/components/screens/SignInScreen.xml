<?xml version="1.0" encoding="utf-8" ?>
<!-- Android TV's link layout: steps and actions on the left, four code tiles on the right. -->
<component name="SignInScreen" extends="Group">
    <interface>
        <field id="params" type="assocarray" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <function name="takeFocus" />
        <function name="leaving" />
        <function name="returned" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/shared/http.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/api.bs" />
    <children>
        <Poster uri="pkg:/images/auth/background.jpg" width="1920" height="1080" />
        <Poster uri="pkg:/images/logo-sign-in.png" width="360" height="96" translation="[192, 192]" />
        <Label id="title" translation="[192, 332]" width="780" font="font:LargeBoldSystemFont" color="0xF5F5F7FF" />
        <Group id="steps" translation="[192, 472]" />
        <Group translation="[192, 812]">
            <Capsule id="newCodeBack" width="282" height="76" />
            <Label id="newCodeLabel" width="282" height="76" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" />
            <Capsule id="otherBack" width="310" height="76" translation="[306, 0]" />
            <Label id="otherLabel" width="310" height="76" translation="[306, 0]" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" />
        </Group>
        <Group id="tiles" translation="[1024, 356]" />
        <Poster id="linkSpinner" uri="pkg:/images/spinner.png" translation="[1062, 630]" width="34" height="34" scaleRotateCenter="[17, 17]" visible="false" />
        <Animation id="linkSpin" duration="1" repeat="true">
            <FloatFieldInterpolator fieldToInterp="linkSpinner.rotation" key="[0.0, 1.0]" keyValue="[0.0, 6.283185]" />
        </Animation>
        <Label id="note" width="690" horizAlign="center" wrap="true" maxLines="2" translation="[1024, 620]" font="font:SmallSystemFont" color="0xB0B0B8FF" />
        <Label id="server" width="690" horizAlign="center" translation="[1024, 700]" font="font:SmallSystemFont" color="0x888891FF" />
        <Timer id="poll" repeat="false" duration="3" />
    </children>
</component>
