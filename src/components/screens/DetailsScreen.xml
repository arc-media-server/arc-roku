<?xml version="1.0" encoding="utf-8" ?>
<!-- A title's page, as the Apple TV app's: the artwork full screen, its logo, the rating box and
     genres, the overview, the year, length and quality badges, Starring and Director, the buttons
     (Play or Resume, Play from the beginning, Watched, Watchlist), then rows: a show's seasons,
     Trailers & Extras, Related, the cast (round pictures) and the collections it's in. -->
<component name="DetailsScreen" extends="Group">
    <interface>
        <field id="params" type="assocarray" onChange="onParams" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <function name="takeFocus" />
        <function name="leaving" />
        <function name="returned" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/shared/http.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/api.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/format.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/seasons.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/cards.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/quality.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/titlepage.bs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" loadWidth="1920" loadHeight="1080" />
        <Poster uri="pkg:/images/shade.png" width="1920" height="1080" />
        <!-- Everything over the artwork; it slides up when the rows below the buttons have the focus. -->
        <Group id="page">
            <Poster id="logo" translation="[120, 96]" width="640" height="200" loadDisplayMode="scaleToFit" loadWidth="640" loadHeight="200" />
            <Label id="title" translation="[120, 170]" width="1200" font="font:LargeBoldSystemFont" color="0xF0F4F4FF" />
            <!-- As the Apple TV's: the rating box and genres, the overview, then the year and length
                 with the file's quality badges; Starring and Director at the right. -->
            <LayoutGroup id="line1" translation="[120, 336]" layoutDirection="horiz" itemSpacings="[16]" vertAlignment="center" />
            <Label id="overview" translation="[120, 384]" width="1000" height="130" wrap="true" maxLines="3" font="font:SmallSystemFont" color="0xC6D0D0FF" />
            <LayoutGroup id="line2" translation="[120, 546]" layoutDirection="horiz" itemSpacings="[12]" vertAlignment="center" />
            <Label id="starring" translation="[1220, 460]" width="580" wrap="true" maxLines="2" horizAlign="right" font="font:SmallestSystemFont" color="0xC6D0D0FF" />
            <Label id="director" translation="[1220, 532]" width="580" horizAlign="right" font="font:SmallestSystemFont" color="0xC6D0D0FF" />
            <ButtonBar id="buttons" translation="[120, 594]" />
            <RowList id="episodes" translation="[120, 740]" itemComponentName="CardItem" numRows="2" itemSize="[1800, 420]" vertFocusAnimationStyle="fixedFocus"
                rowItemSize="[[400, 330]]" rowItemSpacing="[[28, 0]]" itemSpacing="[0, 40]" showRowLabel="[true]"
                rowLabelOffset="[[0, 16]]" rowLabelColor="0xF0F4F4FF" rowLabelFont="font:MediumBoldSystemFont"
                drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" visible="false" />
            <Label id="error" translation="[120, 680]" width="1400" wrap="true" font="font:SmallSystemFont" color="0xF59E9EFF" />
        </Group>
        <Animation id="slide" duration="0.25" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="slideTo" key="[0.0, 1.0]" fieldToInterp="page.translation" />
        </Animation>
    </children>
</component>
