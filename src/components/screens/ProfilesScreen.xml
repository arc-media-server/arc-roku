<?xml version="1.0" encoding="utf-8" ?>
<!-- "Who's watching?": the household's profiles, with Roku's PIN pad for a profile that has one. -->
<component name="ProfilesScreen" extends="Group">
    <interface>
        <field id="params" type="assocarray" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <function name="takeFocus" />
        <function name="leaving" />
        <function name="returned" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/shared/http.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/api.bs" />
    <children>
        <Label id="title" width="1920" horizAlign="center" translation="[0, 220]" font="font:LargeBoldSystemFont" color="0xF0F4F4FF" />
        <MarkupGrid id="grid" itemComponentName="ProfileItem" itemSize="[280, 380]" itemSpacing="[40, 0]" numRows="1" numColumns="5"
            drawFocusFeedback="false" translation="[0, 380]" />
        <Label id="error" width="1920" horizAlign="center" translation="[0, 800]" font="font:SmallSystemFont" color="0xF59E9EFF" />
        <ButtonGroup id="buttons" iconUri="" focusedIconUri="" translation="[810, 880]" minWidth="300" />
    </children>
</component>
