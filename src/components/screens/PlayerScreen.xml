<?xml version="1.0" encoding="utf-8" ?>
<!-- The player: Roku's own Video node with Arc's controls over it (Roku's are hidden, because a
     converted stream only has what's been made so far, and seeking past that starts a new one). -->
<component name="PlayerScreen" extends="Group">
    <interface>
        <field id="params" type="assocarray" onChange="onParams" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <function name="takeFocus" />
        <function name="leaving" />
        <function name="returned" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/shared/http.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/api.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/format.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/seasons.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/bif.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/tracks.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/quality.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/playerosd.bs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="false" />
        <!-- Subtitles are drawn here from Arc's WebVTT, as the LG/Samsung app does: the same look
             (the profile's size, colour, background and position) on every Roku. -->
        <Group id="subs" />
        <BusySpinner id="spinner" translation="[912, 492]" />
        <!-- The controls, in the Apple TV app's arrangement: the show's name large at the bottom left
             with "S2, E4 • name" above it, three round buttons at the right (Playback, Audio,
             Subtitles), the timeline split at the chapters with the time played under its marker
             and the time left at the end, and a tab row under it (Info, Chapters, Cast, Episodes)
             whose card slides up while the title and timeline step aside. -->
        <Group id="controls" visible="false">
            <Poster uri="pkg:/images/shade.png" width="1920" height="1080" rotation="0" opacity="0.85" />
            <Group id="main">
                <Label id="subtitle" translation="[120, 742]" width="1300" font="font:SmallSystemFont" color="0xE6E9E9FF" />
                <Label id="title" translation="[120, 778]" width="1360" font="font:LargeBoldSystemFont" color="0xF5F5F7FF" />
                <Group id="buttons" translation="[1560, 786]" />
                <Group id="segments" translation="[120, 884]" />
                <Rectangle id="head" translation="[120, 875]" width="6" height="30" color="0xFFFFFFFF" />
                <Group id="elapsed" translation="[120, 914]">
                    <Label id="position" font="font:SmallBoldSystemFont" color="0xF5F5F7FF" />
                    <Poster id="playState" translation="[0, 9]" width="22" height="22" uri="pkg:/images/play-mini.png" />
                </Group>
                <Label id="remaining" translation="[1400, 914]" width="400" horizAlign="right" font="font:SmallBoldSystemFont" color="0xF5F5F7FF" />
            </Group>
            <Group id="thumbGroup" visible="false">
                <Rectangle id="thumbEdge" width="330" height="190" color="0xFFFFFFFF" />
                <Poster id="thumb" translation="[5, 5]" width="320" height="180" />
                <Label id="chapter" translation="[0, 196]" width="330" font="font:SmallestBoldSystemFont" color="0xF5F5F7FF" />
            </Group>
            <Group id="tabs" translation="[120, 976]" />
            <Group id="card" translation="[120, 700]" visible="false" />
            <Label id="state" visible="false" />
            <Label id="hint" visible="false" />
        </Group>
        <Group id="skip" visible="false" translation="[1460, 840]">
            <Rectangle width="340" height="72" color="0xF0F4F4FF" />
            <Label id="skipText" width="340" height="72" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" color="0x0B1214FF" />
        </Group>
        <Group id="upNext" visible="false" translation="[1160, 640]">
            <Rectangle width="660" height="340" color="0x0B1214F0" />
            <Poster id="upNextThumb" translation="[30, 30]" width="320" height="180" loadDisplayMode="scaleToZoom" />
            <Label id="upNextHeading" translation="[370, 30]" width="260" font="font:SmallestBoldSystemFont" color="0xF5F5F7FF" />
            <Label id="upNextTitle" translation="[370, 66]" width="260" height="140" wrap="true" maxLines="3" font="font:SmallSystemFont" color="0xF0F4F4FF" />
            <Label id="upNextCount" translation="[30, 230]" width="600" font="font:SmallBoldSystemFont" color="0xF0F4F4FF" />
            <Label id="upNextKeys" translation="[30, 280]" width="600" font="font:SmallestSystemFont" color="0xC6D0D0FF" />
        </Group>
        <OptionsPanel id="options" visible="false" />
        <Label id="error" translation="[160, 460]" width="1600" horizAlign="center" wrap="true" font="font:MediumSystemFont" color="0xF0F4F4FF" visible="false" />
        <Timer id="progressTimer" repeat="true" duration="10" />
        <Timer id="pingTimer" repeat="true" duration="30" />
        <Timer id="tick" repeat="true" duration="0.25" />
        <Timer id="hideTimer" repeat="false" duration="5" />
        <Timer id="seekTimer" repeat="false" duration="0.9" />
        <Timer id="upNextTimer" repeat="true" duration="1" />
    </children>
</component>
