' A row per choice with its value; OK flips an on/off choice or opens the choices beside the list.
' Preferences are saved with PATCH /me/prefs, as the other apps save them.

sub init()
    m.rows = m.top.findNode("rows")
    m.rows.observeField("itemSelected", "onRow")
    m.rows.observeField("itemFocused", "onRowFocus")
    m.options = m.top.findNode("options")
    m.options.observeField("picked", "onPicked")
    m.options.observeField("closed", "onClosed")
    ' Live updates
    m.options.observeField("visible", "onLiveOptionsVisibility")
    m.top.findNode("heading").text = tr("Settings")
    m.note = m.top.findNode("note")
    onRowFocus()
    profile = m.global.profile
    color = "teal"
    name = ""
    if profile <> invalid
        if profile.color <> invalid and profile.color <> "" then color = profile.color
        if profile.name <> invalid then name = profile.name
    end if
    m.top.findNode("avatar").uri = "pkg:/images/avatars/" + color + ".png"
    m.top.findNode("letter").text = UCase(Left(name, 1))
    m.top.findNode("profileName").text = name
    m.top.findNode("serverLine").text = m.global.serverName
    m.deviceProfile = profile
    m.prefs = invalid
    m.rowKeys = []
    callApi("GET", "/me/prefs", invalid, "onPrefs")
    callApi("GET", "/auth/status", invalid, "onDeviceProfile")
end sub

sub takeFocus(_ = invalid as dynamic)
    if m.options.visible then m.options.show = true else m.rows.setFocus(true)
end sub

sub leaving(_ = invalid as dynamic)
end sub

sub returned(_ = invalid as dynamic)
end sub

sub onDeviceProfile(event as object)
    res = event.getData()
    if res.ok and res.data <> invalid
        m.deviceProfile = res.data.profile
        if m.prefs <> invalid then draw()
    end if
end sub

sub onRowFocus()
    if m.rows = invalid or m.note = invalid then return
    profile = m.deviceProfile
    i = m.rows.itemFocused
    if profile <> invalid and m.rowKeys <> invalid and i >= 0 and i < m.rowKeys.Count()
        if m.rowKeys[i] = "automaticProfile"
            if profile.has_pin = true
                m.note.text = tr("Not available for a profile with a PIN: it's asked for each time.")
            else
                m.note.text = tr("Open as %1 on this device, without asking who's watching.").Replace("%1", profile.name)
            end if
            return
        end if
    end if
    if m.rowKeys <> invalid and i >= 0 and i < m.rowKeys.Count()
        if m.rowKeys[i] = "sendLogs" or m.rowKeys[i] = "detailedLogs"
            m.note.text = tr("Detailed logging turns off after two hours. Sending shares recent app events with this server’s admin.")
            return
        end if
    end if
    m.note.text = tr("Playback and subtitle choices follow your profile, on every device. Choosing a track in the player updates them too.")
end sub

sub onPrefs(event as object)
    res = event.getData()
    m.prefs = {}
    if res.ok and res.data <> invalid then m.prefs = res.data
    draw()
end sub

' Live updates: avoid replacing an open options panel.
sub liveRefresh(_ = invalid as dynamic)
    if m.options.visible
        m.liveDirty = true
        return
    end if
    m.liveDirty = false
    callApi("GET", "/me/prefs", invalid, "onPrefs")
    callApi("GET", "/auth/status", invalid, "onDeviceProfile")
end sub

sub onLiveOptionsVisibility()
    if not m.options.visible and m.liveDirty = true then liveRefresh()
end sub

function pref(name as string, fallback as dynamic) as dynamic
    if m.prefs = invalid or m.prefs[name] = invalid then return fallback
    return m.prefs[name]
end function

function styleValue(name as string, fallback as string) as string
    style = pref("subtitle_style", {})
    if style = invalid or style[name] = invalid or style[name] = "" then return fallback
    return style[name]
end function

function onOff(on as boolean) as string
    if on then return tr("On")
    return tr("Off")
end function

' choices: the values and names for each kind of choice.
function choices(key as string) as object
    if key = "subtitle_mode" then return [["", tr("In the language I last chose")], ["foreign", tr("When the audio is in another language")], ["always", tr("Always")], ["manual", tr("Only when I choose them")]]
    if key = "size" then return [["medium", tr("Medium")], ["small", tr("Small")], ["large", tr("Large")], ["huge", tr("Huge")]]
    if key = "color" then return [["white", tr("White")], ["yellow", tr("Yellow")]]
    if key = "background" then return [["box", tr("Shaded box")], ["solid", tr("Solid black")], ["none", tr("Outline only")]]
    if key = "position" then return [["bottom", tr("Bottom")], ["top", tr("Top")]]
    if key = "audio_language" or key = "subtitle_language"
        none = tr("None")
        if key = "audio_language" then none = tr("The file's default")
        out = [["", none]]
        for each code in ["eng", "fra", "deu", "spa", "ita", "por", "nld", "swe", "nor", "dan", "fin", "pol", "ces", "hun", "ell", "tur", "rus", "ukr", "ara", "heb", "hin", "jpn", "kor", "zho", "tha", "vie"]
            out.Push([code, languageName(code)])
        end for
        return out
    end if
    return []
end function

function choiceName(key as string, value as string) as string
    list = choices(key)
    for each c in list
        if c[0] = value then return c[1]
    end for
    if value <> "" and (key = "audio_language" or key = "subtitle_language") then return languageName(value)
    return list[0][1]
end function

function currentValue(key as string) as string
    if key = "size" then return styleValue("size", "medium")
    if key = "color" then return styleValue("color", "white")
    if key = "background" then return styleValue("background", "box")
    if key = "position" then return styleValue("position", "bottom")
    return valueString(pref(key, ""))
end function

sub draw()
    rows = []
    rows.Push(["auto_play", tr("Auto-Play Next Episode"), onOff(pref("auto_play", true) <> false)])
    rows.Push(["hide_spoilers", tr("Hide Spoilers"), onOff(pref("hide_spoilers", false) = true)])
    rows.Push(["show_missing_episodes", tr("Show Missing Episodes"), onOff(pref("show_missing_episodes", false) = true)])
    rows.Push(["auto_skip", tr("Skip Intros Automatically"), onOff(pref("auto_skip", false) = true)])
    ' Theme music
    rows.Push(["theme_music", tr("Theme Music"), onOff(pref("theme_music", true) <> false)])
    for each key in ["audio_language", "subtitle_mode", "subtitle_language", "size", "color", "background", "position"]
        rows.Push([key, choiceLabel(key), choiceName(key, currentValue(key))])
    end for
    profile = m.global.profile
    name = ""
    if profile <> invalid and profile.name <> invalid then name = profile.name
    deviceProfile = m.deviceProfile
    if deviceProfile <> invalid and deviceProfile.id <> invalid
        automatic = deviceProfile.has_pin <> true and readSetting("automaticProfile") = deviceProfile.id
        rows.Push(["automaticProfile", tr("Sign in automatically"), onOff(automatic)])
    end if
    rows.Push(["profiles", tr("Switch Profile"), name])
    rows.Push(["server", tr("Server"), m.global.serverName])
    rows.Push(["signOut", tr("Sign Out of This Roku"), ""])
    until = Val(readSetting("detailedLogsUntil"))
    rows.Push(["detailedLogs", tr("Detailed logging"), onOff(until > CreateObject("roDateTime").AsSeconds())])
    rows.Push(["sendLogs", tr("Send logs"), ""])
    rows.Push(["about", tr("About"), CreateObject("roAppInfo").GetVersion()])
    content = CreateObject("roSGNode", "ContentNode")
    m.rowKeys = []
    for each r in rows
        node = content.createChild("ContentNode")
        if r[2] <> "" then node.title = r[1] + ":   " + r[2] else node.title = r[1]
        m.rowKeys.Push(r[0])
    end for
    focused = m.rows.itemFocused
    m.rows.content = content
    if focused > 0 then m.rows.jumpToItem = focused
    onRowFocus()
end sub

function choiceLabel(key as string) as string
    names = { audio_language: tr("Preferred Audio Language"), subtitle_mode: tr("Show Subtitles"), subtitle_language: tr("Subtitle Language"), size: tr("Subtitle Size"), color: tr("Subtitle Colour"), background: tr("Subtitle Background"), position: tr("Subtitle Position") }
    return names[key]
end function

sub onRow()
    index = m.rows.itemSelected
    if index < 0 or index >= m.rowKeys.Count() then return
    key = m.rowKeys[index]
    if key = "auto_play"
        save("auto_play", pref("auto_play", true) = false)
    else if key = "hide_spoilers"
        saveSpoilers()
    else if key = "show_missing_episodes"
        if m.savingMissingEpisodes = true then return
        m.savingMissingEpisodes = true
        body = { show_missing_episodes: pref("show_missing_episodes", false) <> true }
        callApi("PATCH", "/me/prefs", body, "onMissingEpisodesSaved")
    else if key = "auto_skip"
        save("auto_skip", pref("auto_skip", false) <> true)
    else if key = "theme_music"
        save("theme_music", pref("theme_music", true) = false)
    else if key = "automaticProfile"
        profile = m.deviceProfile
        if profile = invalid or profile.has_pin = true then return
        if readSetting("automaticProfile") = profile.id
            clearSetting("automaticProfile")
        else
            writeSetting("automaticProfile", profile.id)
        end if
        draw()
    else if key = "profiles"
        m.top.action = { go: "profiles" }
    else if key = "server"
        m.top.action = { go: "otherServer" }
    else if key = "signOut"
        m.top.action = { go: "signOut" }
    else if key = "sendLogs" or key = "detailedLogs"
        m.top.action = { go: key }
    else if key = "about"
        m.top.action = { go: "about" }
    else
        m.picking = key
        list = choices(key)
        entries = []
        selected = 0
        current = currentValue(key)
        for i = 0 to list.Count() - 1
            if list[i][0] = current then selected = i
            entries.Push({ label: list[i][1], detail: "" })
        end for
        m.options.title = choiceLabel(key)
        m.options.entries = entries
        m.options.selected = selected
        m.options.visible = true
        m.options.show = true
    end if
end sub

sub onPicked()
    key = m.picking
    value = choices(key)[m.options.picked][0]
    closePanel()
    if key = "size" or key = "color" or key = "background" or key = "position"
        style = {}
        old = pref("subtitle_style", {})
        if old <> invalid then style.Append(old)
        style[key] = value
        save("subtitle_style", style)
    else
        save(key, value)
    end if
end sub

sub onClosed()
    closePanel()
end sub

sub closePanel()
    m.options.visible = false
    m.rows.setFocus(true)
end sub

' save: shown at once; a failure to save is left quiet, as on the other apps.
sub save(key as string, value as dynamic)
    m.prefs[key] = value
    body = {}
    body[key] = value
    callApi("PATCH", "/me/prefs", body, "onSaved")
    draw()
end sub

sub onSaved(event as object)
end sub

sub onMissingEpisodesSaved(event as object)
    m.savingMissingEpisodes = false
    res = event.getData()
    if res.ok and res.data <> invalid
        m.prefs.show_missing_episodes = res.data.show_missing_episodes = true
        draw()
    else
        m.note.text = tr("Couldn't save this setting. Try again.")
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.options.visible then return true
    return false
end function

' The spoiler choice only changes after a successful save; retry is the same row's OK.
sub saveSpoilers()
    if m.savingSpoilers = true then return
    m.savingSpoilers = true
    m.global.spoilerRevision++
    body = { hide_spoilers: pref("hide_spoilers", false) <> true }
    callApi("PATCH", "/me/prefs", body, "onSpoilersSaved", { profile: m.global.profile.id })
end sub

sub onSpoilersSaved(event as object)
    m.savingSpoilers = false
    res = event.getData()
    if res.tag = invalid or res.tag.profile <> m.global.profile.id then return
    if res.ok and res.data <> invalid
        m.prefs = res.data
        m.global.hideSpoilers = res.data.hide_spoilers = true
        m.note = m.top.findNode("note")
    onRowFocus()
        draw()
    else
        ' The API Task logs the failed route once; don't print provider bodies or URLs here.
        m.top.findNode("note").text = tr("Couldn't save this setting. Try again.")
    end if
end sub

sub diagnosticsChanged()
    draw()
end sub
