sub init()
    m.global.observeField("hideSpoilers", "renderSummary")
    initThemeMusic()
    m.backdrop = m.top.findNode("backdrop")
    m.logo = m.top.findNode("logo")
    m.titleLabel = m.top.findNode("title")
    m.line1 = m.top.findNode("line1")
    m.line2 = m.top.findNode("line2")
    m.starring = m.top.findNode("starring")
    m.director = m.top.findNode("director")
    m.overview = m.top.findNode("overview")
    m.buttons = m.top.findNode("buttons")
    m.episodes = m.top.findNode("episodes")
    m.error = m.top.findNode("error")
    shareSignIn([m.backdrop, m.logo])
    m.buttons.observeField("picked", "onButton")
    m.page = m.top.findNode("page")
    m.slide = m.top.findNode("slide")
    m.slideTo = m.top.findNode("slideTo")
    m.episodes.observeField("rowItemSelected", "onEpisode")
    m.episodes.observeField("rowItemFocused", "onRowFocus")
    m.focusRow = ""
    m.focusCol = 0
    m.restoring = false
    m.item = invalid
    m.seasons = invalid
    m.showMissing = false
    m.seasonsRequest = 0
    m.related = {}
    m.landed = false
    m.actions = []
    m.cardPanel = m.top.findNode("cardPanel")
    m.cardPanel.observeField("picked", "onCardPicked")
    m.cardPanel.observeField("closed", "closeCardPanel")
    ' Live updates
    m.cardPanel.observeField("visible", "onLivePanelVisibility")
end sub

sub onParams()
    m.showMissing = false
    m.seasonsRequest++
    beginThemeVisit()
    load()
end sub

' Coming back (from the player or another page), the focus returns where it was.
sub takeFocus(_ = invalid as dynamic)
    if m.rowsFocused = true then focusRows() else focusButtons()
end sub

' The page slides up so the rows sit under the top of the screen, and back down for the buttons.
sub focusButtons()
    m.rowsFocused = false
    m.buttons.opacity = 1
    m.buttons.setFocus(true)
    slideTo(0)
end sub

' The buttons fade while the rows have the focus: they'd show their focused one otherwise.
sub focusRows()
    m.rowsFocused = true
    m.buttons.opacity = 0
    m.episodes.setFocus(true)
    slideTo(-560)
end sub

sub slideTo(y as integer)
    if m.page.translation[1] = y then return
    m.slide.control = "stop"
    m.slideTo.keyValue = [m.page.translation, [0, y]]
    m.slide.control = "start"
end sub

sub leaving(_ = invalid as dynamic)
    stopThemeMusic()
end sub

' Back from the player: the resume point and watched state have changed.
sub returned(_ = invalid as dynamic)
    load()
end sub

' Live updates: avoid replacing an open options panel.
sub liveRefresh(_ = invalid as dynamic)
    if m.cardPanel.visible
        m.liveDirty = true
        return
    end if
    m.liveDirty = false
    m.keepPlace = true
    load()
end sub

sub onLivePanelVisibility()
    if not m.cardPanel.visible and m.liveDirty = true then liveRefresh()
end sub

sub load()
    id = m.top.params.id
    callApi("GET", "/items/" + escape(id), invalid, "onItem", id)
end sub

function escape(s as string) as string
    return CreateObject("roUrlTransfer").Escape(s)
end function

sub onItem(event as object)
    res = event.getData()
    if not res.ok
        m.error.text = tr("Couldn't load this title.") + " " + res.error
        return
    end if
    if res.tag <> m.top.params.id then return
    m.item = res.data
    loadThemeMusic()
    renderSummary()
    it = m.item
    m.related = {}
    if it.kind = "series"
        requestSeasons(m.showMissing)
    else
        m.seasons = []
        m.seasonRows = []
    end if
    if it.kind <> "episode"
        callApi("GET", "/items/" + escape(it.id) + "/similar", invalid, "onSimilar", it.id)
        m.pendingCollections = 0
        if it.collections <> invalid
            for each c in it.collections
                m.pendingCollections = m.pendingCollections + 1
                callApi("GET", "/collections/" + escape(c.id), invalid, "onCollection", { id: it.id, collection: c.id })
            end for
        end if
    end if
    showButtons()
    buildRows()
end sub

' The rating box and genres; the year, length and quality badges; Starring and Director.
sub showHeroLines(it as object)
    m.line1.removeChildrenIndex(m.line1.getChildCount(), 0)
    m.line2.removeChildrenIndex(m.line2.getChildCount(), 0)
    if it.content_rating <> invalid and it.content_rating <> ""
        m.line1.createChild("OutlinedBadge").text = it.content_rating
    end if
    addHeroText(m.line1, heroGenres(it), "font:SmallBoldSystemFont")
    addHeroText(m.line2, heroFacts(it), "font:SmallSystemFont")
    for each b in qualityBadges(qualityFile(it))
        m.line2.createChild("OutlinedBadge").text = b
    end for
    stars = joinNames(creditNames(it, "actor", 3))
    m.starring.text = ""
    if stars <> "" then m.starring.text = tr("Starring %1").Replace("%1", stars)
    directors = joinNames(creditNames(it, "director", 2))
    m.director.text = ""
    if directors <> "" then m.director.text = tr("Director %1").Replace("%1", directors)
end sub

sub addHeroText(group as object, text as string, font as string)
    if text = "" then return
    label = group.createChild("Label")
    label.font = font
    label.color = "0xE4EAEAFF"
    label.text = text
end sub

sub onSimilar(event as object)
    res = event.getData()
    if m.item = invalid or res.tag <> m.item.id then return
    if res.ok and res.data <> invalid then m.related.similar = res.data
    buildRows()
end sub

sub onCollection(event as object)
    res = event.getData()
    if m.item = invalid or res.tag.id <> m.item.id then return
    if res.ok and res.data <> invalid then m.related["collection:" + res.tag.collection] = res.data
    buildRows()
end sub

' nextEpisode: the one part-way through, else the first not watched, specials last.
function nextEpisode() as dynamic
    if m.seasons = invalid then return invalid
    ordered = []
    for each s in m.seasons
        if s.season_number > 0 then ordered.Push(s)
    end for
    for each s in m.seasons
        if s.season_number <= 0 then ordered.Push(s)
    end for
    first = invalid
    unwatched = invalid
    for each s in ordered
        for each e in s.episodes
            if e.available <> false
                if first = invalid then first = e
                if resumeMs(e) > 0 then return e
                if unwatched = invalid and (e.user_data = invalid or e.user_data.played <> true) then unwatched = e
            end if
        end for
    end for
    if unwatched <> invalid then return unwatched
    return first
end function


' Star rating: the existing OptionsPanel, with current choice ticked and focused.
sub showTitleMenu()
    m.ratingPanel = "more"
    m.cardPanel.title = m.item.title
    current = 0
    if m.item.user_data <> invalid and m.item.user_data.rating <> invalid then current = m.item.user_data.rating
    entries = [{ label: tr("Rate…"), detail: ratingStars(current) }]
    if m.item.kind = "series" then entries.Push(missingEpisodesEntry(m.showMissing))
    m.cardPanel.entries = entries
    m.cardPanel.selected = -1
    m.cardPanel.visible = true
    m.cardPanel.show = true
end sub

sub onRatingPicked()
    i = m.cardPanel.picked
    if m.ratingPanel = "more"
        if i = 1 and m.item.kind = "series"
            closeCardPanel()
            toggleMissingEpisodes()
            return
        end if
        if i <> 0 then return
        current = 0
        if m.item.user_data <> invalid and m.item.user_data.rating <> invalid then current = m.item.user_data.rating
        m.ratingEntries = ratingChoices(current)
        m.ratingPanel = "rating"
        m.cardPanel.title = tr("Your Rating")
        m.cardPanel.entries = m.ratingEntries
        selected = -1
        if current > 0 then selected = 10 - current
        m.cardPanel.selected = selected
        m.cardPanel.show = true
        return
    end if
    if i < 0 or i >= m.ratingEntries.Count() then return
    rating = m.ratingEntries[i].rating
    current = 0
    if m.item.user_data <> invalid and m.item.user_data.rating <> invalid then current = m.item.user_data.rating
    closeCardPanel()
    if rating = current then return
    if m.item.user_data = invalid then m.item.user_data = {}
    m.item.user_data.rating = rating
    m.error.text = ""
    req = ratingRequest(m.item.id, rating)
    callApi(req.method, req.path, req.body, "onRatingSaved", { id: m.item.id, rating: rating, previous: current })
end sub

sub onRatingSaved(event as object)
    res = event.getData()
    if m.item = invalid or res.tag.id <> m.item.id then return
    if res.ok
        print "Arc: rating saved"
        load()
    else
        print "Arc: rating not saved"
        if m.item.user_data.rating = res.tag.rating then m.item.user_data.rating = res.tag.previous
        m.error.text = tr("Couldn't save your rating. Try again.")
    end if
end sub

sub showButtons()
    it = m.item
    if it = invalid then return
    buttons = []
    m.actions = []
    playable = it.kind = "movie" or it.kind = "episode"
    target = invalid
    if playable then target = it
    if it.kind = "series" then target = nextEpisode()
    if target <> invalid
        buttons.Push({ label: playLabel(target), icon: "play", wide: true })
        m.actions.Push({ kind: "play", item: target, startMs: resumeMs(target) })
        if resumeMs(target) > 0
            buttons.Push({ label: tr("Play from the beginning"), icon: "restart" })
            m.actions.Push({ kind: "play", item: target, startMs: 0 })
        end if
    end if
    watched = it.user_data <> invalid and it.user_data.played = true
    if it.kind = "series" then watched = it.unwatched_count <> invalid and it.unwatched_count = 0
    if watched
        buttons.Push({ label: tr("Mark as unwatched"), icon: "eye-slash" })
    else
        buttons.Push({ label: tr("Mark as watched"), icon: "eye" })
    end if
    m.actions.Push({ kind: "watched", on: not watched })
    if it.kind <> "episode"
        listed = it.user_data <> invalid and it.user_data.watchlisted = true
        if listed
            buttons.Push({ label: tr("Remove from Watchlist"), icon: "bookmark-slash" })
        else
            buttons.Push({ label: tr("Add to Watchlist"), icon: "bookmark" })
        end if
        m.actions.Push({ kind: "watchlist", on: not listed })
    end if
    if it.kind = "episode" and it.parent_id <> invalid
        buttons.Push({ label: tr("Go to show"), icon: "show" })
        m.actions.Push({ kind: "open", id: it.parent_id })
    end if
    ' Star rating: reuse the title's button bar and OptionsPanel.
    buttons.Push({ label: tr("More"), icon: "more" })
    m.actions.Push({ kind: "more" })
    ' The focus stays on the same button when the page reloads (after Watched, say).
    keep = m.buttons.focusIndex
    m.buttons.buttons = buttons
    if keep < buttons.Count() then m.buttons.focusIndex = keep
end sub

sub onButton()
    a = m.actions[m.buttons.picked]
    if a = invalid then return
    if a.kind = "play"
        m.top.action = { go: "play", id: a.item.id, startMs: a.startMs, title: m.item.title, subtitle: episodeLine(a.item) }
    else if a.kind = "watched"
        callApi("PUT", "/items/" + escape(m.item.id) + "/played", { played: a.on }, "onChanged")
    else if a.kind = "watchlist"
        callApi("PUT", "/items/" + escape(m.item.id) + "/watchlist", { on: a.on }, "onChanged")
    else if a.kind = "more"
        showTitleMenu()
    else if a.kind = "open"
        m.top.action = { go: "open", id: a.id }
    end if
end sub

sub onChanged(event as object)
    res = event.getData()
    if res.ok
        load()
    else
        m.error.text = res.error
    end if
end sub

sub requestSeasons(missing as boolean)
    m.seasonsRequest++
    callApi("GET", seasonsPath(m.item.id, missing), invalid, "onSeasons", { id: m.item.id, missing: missing, request: m.seasonsRequest })
end sub

sub toggleMissingEpisodes()
    m.keepPlace = true
    requestSeasons(not m.showMissing)
end sub

sub onSeasons(event as object)
    res = event.getData()
    if m.item = invalid or res.tag = invalid then return
    if res.tag.id <> m.item.id or res.tag.request <> m.seasonsRequest then return
    if not res.ok or res.data = invalid
        m.error.text = tr("Couldn't load episodes. Try again.")
        return
    end if
    m.error.text = ""
    m.showMissing = res.tag.missing
    m.seasons = valueOr(res.data.seasons, [])
    ' Each season, then the episodes the order doesn't place ("Not in This Order").
    m.seasonRows = []
    if res.ok then m.seasonRows = seasonRows(res.data)
    ' After a change from the * menu the focus stays where it was; otherwise it lands afresh.
    if m.keepPlace <> true then m.landed = false
    m.keepPlace = false
    buildRows()
    showButtons()
end sub

' buildRows lays out what's under the buttons, as the Apple TV app's title page: a show's seasons,
' then Trailers & Extras, More Like This, the cast and the collections the title is in. Rows are rebuilt as
' each part arrives, keeping the focus where it was.
sub buildRows()
    it = m.item
    if it = invalid or m.seasons = invalid then return
    specs = []
    rows = valueOr(m.seasonRows, [])
    for i = 0 to rows.Count() - 1
        r = rows[i]
        specs.Push({ kind: "season", title: r.title, style: "thumb", items: r.episodes, unplaced: r.unplaced, season: i })
    end for
    if it.extras <> invalid and it.extras.Count() > 0
        extras = []
        img = valueOr(it.images, {})
        for each e in it.extras
            extras.Push({ item: { id: e.id, kind: "extra", title: e.title, path: e.stream_url, images: { primary: img.backdrop, backdrop: img.backdrop } }, line2: extraKind(e.kind) })
        end for
        specs.Push({ kind: "extra", title: tr("Trailers & Extras"), style: "thumb", cards: extras })
    end if
    if m.related.similar <> invalid and m.related.similar.Count() > 0 then specs.Push({ kind: "title", title: tr("More Like This"), style: "poster", items: m.related.similar })
    if it.credits <> invalid
        cast = []
        for each c in it.credits
            if c.role = "actor" then cast.Push({ item: { id: c.person_id.ToStr(), kind: "person", title: c.name, images: { primary: c.image } }, line2: valueOr(c.character, "") })
        end for
        if cast.Count() > 0 then specs.Push({ kind: "cast", title: tr("Cast"), style: "named", cards: cast })
    end if
    if it.collections <> invalid
        for each c in it.collections
            page = m.related["collection:" + c.id]
            if page <> invalid and page.items <> invalid
                others = []
                for each x in page.items
                    if x.id <> it.id then others.Push(x)
                end for
                if others.Count() > 0 then specs.Push({ kind: "title", title: c.title, style: "poster", items: others })
            end if
        end for
    end if

    content = CreateObject("roSGNode", "ContentNode")
    sizes = []
    heights = []
    for each spec in specs
        row = content.createChild("ContentNode")
        row.title = spec.title
        row.addField("rowKind", "string", false)
        row.rowKind = spec.kind
        row.addField("seasonIndex", "integer", false)
        if spec.season <> invalid then row.seasonIndex = spec.season
        cards = spec.cards
        if cards = invalid
            cards = []
            for each x in spec.items
                cards.Push({ item: x })
            end for
        end if
        for each card in cards
            node = row.createChild("ContentNode")
            node.addFields(cardFields())
            fillCard(node, card, spec.style)
            if spec.kind = "season"
                e = card.item
                node.title = valueOr(e.title, "")
                node.line2 = seasonCardLine(e, spec.unplaced = true)
                node.addField("subtitleLine", "string", false)
                node.subtitleLine = episodeLine(e)
            end if
        end for
        if spec.style = "thumb"
            sizes.Push([400, 330])
        else if spec.style = "named"
            sizes.Push([220, 330])
        else
            sizes.Push([220, 330])
        end if
        heights.Push(420)
    end for
    m.episodes.rowItemSize = sizes
    m.episodes.rowHeights = heights
    m.restoring = true
    m.episodes.content = content
    m.episodes.visible = content.getChildCount() > 0
    if m.landed = true
        ' Rows arrive in turn, so the focus is kept by row title rather than position.
        r = 0
        for each rowNode in content.getChildren(-1, 0)
            if rowNode.title = m.focusRow
                col = m.focusCol
                if m.focusItemId <> invalid and m.focusItemId <> ""
                    for c = 0 to rowNode.getChildCount() - 1
                        if rowNode.getChild(c).itemId = m.focusItemId then col = c
                    end for
                end if
                if col >= rowNode.getChildCount() then col = rowNode.getChildCount() - 1
                if col < 0 then col = 0
                m.episodes.jumpToRowItem = [r, col]
            end if
            r = r + 1
        end for
        m.restoring = false
        return
    end if
    m.landed = true
    m.restoring = false
    ' Land on the episode the page was opened for, else the one Play would start.
    target = nextEpisode()
    wanted = m.top.params.episodeId
    if wanted <> invalid and wanted <> ""
        for each r in valueOr(m.seasonRows, [])
            for each e in r.episodes
                if e.id = wanted then target = e
            end for
        end for
    end if
    if target <> invalid
        r = 0
        for each rowNode in content.getChildren(-1, 0)
            if rowNode.rowKind = "season"
                for c = 0 to rowNode.getChildCount() - 1
                    if rowNode.getChild(c).itemId = target.id then m.episodes.jumpToRowItem = [r, c]
                end for
            end if
            r = r + 1
        end for
    end if
    if wanted <> invalid and wanted <> "" and m.buttons.isInFocusChain() then focusRows()
end sub

function extraKind(kind as dynamic) as string
    names = { trailer: tr("Trailer"), featurette: tr("Featurette"), behindthescenes: tr("Behind the scenes"), deleted: tr("Deleted scene"), interview: tr("Interview"), scene: tr("Scene"), short: tr("Short") }
    if kind <> invalid and names.DoesExist(kind) then return names[kind]
    return tr("Extra")
end function

sub onRowFocus()
    if m.restoring = true then return
    f = m.episodes.rowItemFocused
    if f = invalid or f.Count() < 2 or m.episodes.content = invalid then return
    row = m.episodes.content.getChild(f[0])
    if row = invalid then return
    m.focusRow = row.title
    m.focusCol = f[1]
    m.focusItemId = row.getChild(f[1]).itemId
end sub

sub onEpisode()
    f = m.episodes.rowItemSelected
    row = m.episodes.content.getChild(f[0])
    node = row.getChild(f[1])
    kind = row.rowKind
    if kind = "season"
        if node.available = false or node.itemId = "" then return
        m.top.action = { go: "play", id: node.itemId, startMs: node.resumeMs, title: m.item.title, subtitle: node.subtitleLine }
    else if kind = "cast"
        m.top.action = { go: "person", title: node.title, id: node.itemId }
    else if kind = "extra"
        m.top.action = { go: "playExtra", url: node.path, title: node.title, subtitle: m.item.title }
    else
        m.top.action = { go: "open", id: node.itemId }
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.cardPanel.visible then return true
    if key = "options" and m.buttons.isInFocusChain()
        showTitleMenu()
        return true
    end if
    if key = "options" and m.episodes.isInFocusChain()
        showSeasonMenu()
        return true
    end if
    if key = "down" and m.buttons.isInFocusChain() and m.episodes.visible
        focusRows()
        return true
    end if
    if key = "up" and m.episodes.isInFocusChain()
        focusButtons()
        return true
    end if
    return false
end function

'--- the * menu on a season's episode (cardmenu.bs, seasonactions.bs) ---

' focusedSeason: the focused episode card and its season, when the focus is on a season row.
function focusedSeason() as dynamic
    f = m.episodes.rowItemFocused
    if f = invalid or f.Count() < 2 or m.episodes.content = invalid then return invalid
    row = m.episodes.content.getChild(f[0])
    if row = invalid or row.rowKind <> "season" then return invalid
    node = row.getChild(f[1])
    season = invalid
    if m.seasonRows <> invalid then season = m.seasonRows[row.seasonIndex]
    if node = invalid or season = invalid then return invalid
    return { node: node, season: season, title: row.title }
end function

sub showSeasonMenu()
    at = focusedSeason()
    if at = invalid then return
    ' Not in This Order isn't a season: its episodes keep their own menu, without the season's.
    episodes = at.season.episodes
    if at.season.unplaced = true then episodes = []
    cardEntries = []
    if at.node.available <> false and at.node.itemId <> "" then cardEntries = cardMenu(at.node)
    entries = seasonMenu(cardEntries, episodes)
    entries.Push(missingEpisodesEntry(m.showMissing))
    m.menuAt = at
    m.menuEntries = entries
    list = []
    for each e in entries
        list.Push({ label: e.label, detail: "" })
    end for
    m.cardPanel.title = at.node.title
    m.cardPanel.entries = list
    m.cardPanel.selected = -1
    m.cardPanel.visible = true
    m.cardPanel.show = true
end sub

sub onCardPicked()
    ' Star rating owns this panel only while a title menu/rating list is open.
    if m.ratingPanel <> invalid and m.ratingPanel <> ""
        onRatingPicked()
        return
    end if
    i = m.cardPanel.picked
    closeCardPanel()
    if i < 0 or i >= m.menuEntries.Count() then return
    act = m.menuEntries[i].act
    at = m.menuAt
    node = at.node
    if act = "showMissing" or act = "hideMissing"
        toggleMissingEpisodes()
        return
    end if
    if act = "play" or act = "restart"
        if node.available = false or node.itemId = "" then return
        startMs = node.resumeMs
        if act = "restart" then startMs = 0
        m.top.action = { go: "play", id: node.itemId, startMs: startMs, title: m.item.title, subtitle: node.subtitleLine }
    else if act = "seasonWatched" or act = "seasonUnwatched"
        ' Arc's season_number is the season in the profile's episode order, as these rows are.
        body = { played: act = "seasonWatched", season_number: at.season.season_number }
        callApi("PUT", "/items/" + escape(m.item.id) + "/played", body, "onCardChanged")
    else if act = "shuffleSeason"
        callApi("POST", "/play-queues", { item_ids: shuffledIds(at.season.episodes) }, "onSeasonQueue", m.item.id)
    else
        go = runCardAction(node, act)
        if go <> invalid then m.top.action = go
    end if
end sub

sub closeCardPanel()
    m.cardPanel.visible = false
    if m.ratingPanel <> invalid and m.ratingPanel <> ""
        m.ratingPanel = ""
        focusButtons()
        return
    end if
    focusRows()
end sub

' A watched change is saved: the page loads again (ticks, episodes left, what Play starts).
sub onCardChanged(event as object)
    res = event.getData()
    if res.ok
        m.keepPlace = true
        load()
    else
        m.error.text = tr("Couldn't change what's watched.") + " " + res.error
    end if
end sub

' Shuffle Season's queue is made: play its first entry, with the queue for the player to play on.
sub onSeasonQueue(event as object)
    res = event.getData()
    if m.item = invalid or res.tag <> m.item.id then return
    first = invalid
    if res.ok then first = queueCurrent(res.data)
    if first = invalid
        m.error.text = tr("Couldn't start playing this season.") + " " + valueOr(res.error, "")
        return
    end if
    print "Arc: shuffling a season ("; res.data.entries.Count(); " episodes)"
    m.top.action = { go: "play", id: first.item.id, startMs: 0, title: m.item.title, subtitle: episodeLine(first.item), queue: res.data }
end sub

' episodeLine: "S1 E4 · Shindig", for the player's second line.
function episodeLine(e as object) as string
    code = episodeCode(e)
    if code = "" then return valueOr(e.title, "")
    if e.title <> invalid and e.title <> "" then return code + " · " + e.title
    return code
end function

sub renderSummary()
    if m.item = invalid then return
    it = spoilerSafeItem(m.item, hideSpoilers())
    img = it.images
    if img = invalid then img = {}
    ep = it.kind = "episode"
    backdrop = img.backdrop
    if ep then backdrop = img.primary
    if ep and backdrop = invalid then backdrop = img.series_backdrop
    if img.backdrop_full <> invalid and not ep then backdrop = img.backdrop_full
    m.backdrop.uri = imageUrl(backdrop)
    logo = img.logo
    if ep then logo = img.series_logo
    m.logo.uri = imageUrl(logo)
    m.titleLabel.visible = logo = invalid
    if ep and it.series_title <> invalid then m.titleLabel.text = it.series_title else m.titleLabel.text = it.title
    showHeroLines(it)
    m.overview.text = valueOr(it.overview, "")
end sub
