sub init()
    m.top.findNode("title").text = tr("Sign in to %1").Replace("%1", serverLabel())
    m.top.findNode("steps").text = tr("On your phone or computer, open Arc, choose Link a Device from your profile menu, and type this code.")
    m.top.findNode("link").text = m.global.server.Replace("http://", "").Replace("https://", "") + "/link"
    m.code = m.top.findNode("code")
    m.note = m.top.findNode("note")
    m.buttons = m.top.findNode("buttons")
    m.buttons.buttons = [tr("New code"), tr("Use another server")]
    m.buttons.observeField("buttonSelected", "onButton")
    m.timer = m.top.findNode("poll")
    m.timer.observeField("fire", "onPoll")
    m.poll = ""
    m.live = true
    newCode()
end sub

function serverLabel() as string
    if m.global.serverName <> "" then return m.global.serverName
    return "Arc"
end function

sub takeFocus(_ = invalid as dynamic)
    m.buttons.setFocus(true)
end sub

sub leaving(_ = invalid as dynamic)
    m.live = false
    m.timer.control = "stop"
end sub

sub returned(_ = invalid as dynamic)
end sub

sub newCode()
    m.timer.control = "stop"
    m.code.text = "· · · ·"
    m.note.text = ""
    callApi("POST", "/auth/link", { device: deviceName() }, "onLink")
end sub

' deviceName is how this Roku shows in Arc's Settings > Devices, e.g. "Roku Ultra (Living room)".
function deviceName() as string
    di = CreateObject("roDeviceInfo")
    name = di.GetFriendlyName()
    if name = invalid or name = "" then name = "Roku " + di.GetModelDisplayName()
    return name
end function

sub onLink(event as object)
    if not m.live then return
    res = event.getData()
    if not res.ok or res.data = invalid
        m.code.text = ""
        m.note.text = tr("Couldn't get a code from Arc.") + " " + res.error
        return
    end if
    m.code.text = res.data.code
    m.poll = res.data.poll
    m.note.text = tr("Waiting for the code to be approved…")
    m.timer.control = "start"
end sub

sub onPoll()
    if not m.live or m.poll = "" then return
    t = CreateObject("roUrlTransfer")
    callApi("GET", "/auth/link/" + t.Escape(m.poll), invalid, "onPollAnswer")
end sub

sub onPollAnswer(event as object)
    if not m.live then return
    res = event.getData()
    if res.ok and res.data <> invalid and res.data.token <> invalid
        m.live = false
        m.top.action = { go: "token", token: res.data.token }
        return
    end if
    if res.status = 404
        m.code.text = ""
        m.note.text = tr("The code ran out. Choose New code for another.")
        return
    end if
    ' 202 (still waiting) or a hiccup: ask again, a little later after a failure.
    if res.ok then m.timer.duration = 3 else m.timer.duration = 5
    m.timer.control = "start"
end sub

sub onButton()
    if m.buttons.buttonSelected = 0
        newCode()
    else
        m.live = false
        m.timer.control = "stop"
        m.top.action = { go: "otherServer" }
    end if
end sub
