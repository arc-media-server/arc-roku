sub init()
    m.top.findNode("title").text = tr("Who's watching?")
    m.grid = m.top.findNode("grid")
    m.error = m.top.findNode("error")
    m.buttons = m.top.findNode("buttons")
    m.buttons.buttons = [tr("Sign out")]
    m.buttons.observeField("buttonSelected", "onSignOut")
    m.grid.observeField("itemSelected", "onChosen")
    m.profiles = []
    m.live = true
    m.pending = false
    m.picker = m.top.findNode("picker")
    m.pin = m.top.findNode("pinEntry")
    m.pin.observeField("entry", "onPinEntry")
    callApi("GET", "/auth/status", invalid, "onStatus")
end sub

sub takeFocus(_ = invalid as dynamic)
    if m.pin.visible
        m.pin.callFunc("takeFocus", invalid)
    else if m.profiles.Count() > 0
        m.grid.setFocus(true)
    else
        m.buttons.setFocus(true)
    end if
end sub

sub leaving(_ = invalid as dynamic)
    m.live = false
end sub

sub returned(_ = invalid as dynamic)
end sub

sub onStatus(event as object)
    if not m.live then return
    res = event.getData()
    if not res.ok
        m.error.text = res.error
        return
    end if
    m.profiles = res.data.profiles
    if m.profiles = invalid then m.profiles = []
    content = CreateObject("roSGNode", "ContentNode")
    for each p in m.profiles
        c = content.createChild("ContentNode")
        c.addFields({ color: p.color, hasPin: p.has_pin = true })
        c.title = p.name
    end for
    n = m.profiles.Count()
    if n > 5 then n = 5
    if n < 1 then n = 1
    m.grid.numColumns = n
    ' Centred: each profile is 280 wide with 40 between.
    m.grid.translation = [(1920 - (n * 280 + (n - 1) * 40)) / 2, 380]
    m.grid.content = content
    takeFocus()
end sub

sub onChosen()
    index = m.grid.itemSelected
    if m.pending or index < 0 or index >= m.profiles.Count() then return
    p = m.profiles[index]
    m.error.text = ""
    if p.has_pin = true
        askPin(p)
    else
        choose(p, "")
    end if
end sub

sub askPin(p as object)
    m.pinFor = p
    m.pin.profile = p
    m.picker.visible = false
    m.pin.visible = true
    takeFocus()
end sub

sub onPinEntry(event as object)
    entry = event.getData()
    if not m.live or m.pending or not m.pin.visible then return
    if entry.cancel = true
        m.pin.visible = false
        m.picker.visible = true
        m.pinFor = invalid
        takeFocus()
    else if entry.pin <> invalid
        choose(m.pinFor, entry.pin)
    end if
end sub

sub choose(p as object, pin as string)
    m.pending = true
    body = { id: p.id }
    if pin <> "" then body.pin = pin
    callApi("POST", "/auth/profile", body, "onProfile", p)
end sub

sub onProfile(event as object)
    if not m.live then return
    res = event.getData()
    m.pending = false
    if res.ok
        profile = res.data
        if profile = invalid then profile = res.tag
        m.top.action = { go: "profile", profile: profile }
    else if Type(res.data) = "roAssociativeArray" and res.data.needs = "pin"
        if m.pin.visible
            m.pin.callFunc("failed", { wrong: true, message: tr("That PIN isn't right. Try again.") })
        else
            askPin(res.tag)
        end if
    else if m.pin.visible
        m.pin.callFunc("failed", { wrong: false, message: res.error })
    else
        m.error.text = res.error
    end if
end sub

sub onSignOut()
    if m.pending then return
    m.top.action = { go: "signOut" }
end sub
