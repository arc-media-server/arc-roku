<?xml version="1.0" encoding="utf-8" ?>
<!-- Someone's page, as the Apple TV app's: their photo in a circle and their name over the
     focused title's backdrop, a line saying what they do and how many titles they're in, their
     part in the focused title, then rows of what they're in (Movies, TV Shows, Behind the
     Camera), newest first. params: { id, title }. -->
<component name="PersonScreen" extends="Group">
    <interface>
        <field id="params" type="assocarray" onChange="onParams" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <function name="takeFocus" />
        <function name="leaving" />
        <function name="returned" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/shared/spoilers.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/http.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/api.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/format.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/cards.bs" />
    <script type="text/brightscript" uri="pkg:/source/shared/person.bs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x0B1214FF" />
        <Poster id="backdrop" width="1920" height="1080" opacity="0.7" loadDisplayMode="scaleToZoom" loadWidth="1920" loadHeight="1080" />
        <Poster uri="pkg:/images/shade.png" width="1920" height="1080" />
        <Rectangle width="1920" height="1080" color="0x0B121466" />
        <Poster id="photo" translation="[192, 150]" width="240" height="240" loadDisplayMode="scaleToZoom" maskUri="pkg:/images/circle-mask.png" />
        <Label id="initials" translation="[192, 150]" width="240" height="240" horizAlign="center" vertAlign="center" color="0xF5F5F7FF" visible="false">
            <Font role="font" uri="font:BoldSystemFontFile" size="84" />
        </Label>
        <Label id="name" translation="[410, 190]" width="1390" font="font:LargeBoldSystemFont" color="0xF5F5F7FF" />
        <Label id="summary" translation="[410, 278]" width="1390" font="font:SmallBoldSystemFont" color="0xE6E9E9FF" />
        <Label id="part" translation="[410, 326]" width="1390" font="font:SmallSystemFont" color="0xC6D0D0FF" />
        <RowList id="rows" translation="[192, 470]" itemComponentName="CardItem" numRows="2" itemSize="[1728, 400]"
            rowItemSize="[[220, 330]]" rowItemSpacing="[[28, 0]]" itemSpacing="[0, 48]" showRowLabel="[true]" rowLabelOffset="[[0, 16]]"
            rowLabelColor="0xF0F4F4FF" rowLabelFont="font:MediumBoldSystemFont" drawFocusFeedback="false"
            rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus" />
        <Label id="empty" translation="[192, 520]" width="1500" wrap="true" font="font:MediumSystemFont" color="0x9AA7A7FF" visible="false" />
        <BusySpinner id="spinner" translation="[912, 640]" />
    </children>
</component>
