' Home's rows load together: each row asks Arc for its titles, and rows are placed in the
' profile's order as soon as every row above them has answered. Rows with nothing in them are
' left out, as on the web. The * button opens the focused card's menu (cardmenu.bs).
' Left from the first card opens the sidebar (MainScene's NavRail), whose places Home works out
' (places.bs) once it has the libraries and the profile's preferences.

sub init()
    m.global.observeField("hideSpoilers", "showHero")
    m.rows = m.top.findNode("rows")
    m.backdrop = m.top.findNode("backdrop")
    m.logo = m.top.findNode("logo")
    m.heroTitle = m.top.findNode("heroTitle")
    m.heroMeta = m.top.findNode("heroMeta")
    m.heroOverview = m.top.findNode("heroOverview")
    shareSignIn([m.backdrop, m.logo])
    m.logo.observeField("loadStatus", "updateTitleVisibility")
    m.empty = m.top.findNode("empty")
    m.cardPanel = m.top.findNode("cardPanel")
    m.cardPanel.observeField("picked", "onCardPicked")
    m.cardPanel.observeField("closed", "closeCardPanel")
    m.heroDelay = m.top.findNode("heroDelay")
    m.heroDelay.observeField("fire", "showHero")
    m.rows.observeField("rowItemFocused", "onFocusMoved")
    m.rows.observeField("rowItemSelected", "onSelected")
    m.content = CreateObject("roSGNode", "ContentNode")
    m.rows.content = m.content
    m.sizes = []
    m.heights = []
    m.prefs = invalid
    m.libraries = invalid
    m.library = invalid
end sub

' Home loads once its params are set (MainScene sets them as it shows the screen).
sub onParams()
    p = m.top.params
    if p <> invalid then m.library = p.library
    if m.library <> invalid
        ' Under the library's pills: the hero sits lower and has no overview.
        m.logo.translation = [170, 165]
        m.logo.height = 150
        m.heroTitle.translation = [170, 210]
        m.heroOverview.visible = false
    end if
    load()
end sub

sub takeFocus(_ = invalid as dynamic)
    m.cardPanel.visible = false
    m.rows.setFocus(true)
end sub

sub leaving(_ = invalid as dynamic)
end sub

' Back from a title or the player: rows load again (Continue Watching will have changed).
sub returned(_ = invalid as dynamic)
    load()
end sub

sub load()
    if m.library <> invalid
        m.generation = CreateObject("roDateTime").AsSeconds().ToStr() + Rnd(100000).ToStr()
        callApi("GET", "/libraries/" + valueString(m.library.id) + "/recommended", invalid, "onRecommended", m.generation)
        return
    end if
    m.prefs = invalid
    m.libraries = invalid
    m.generation = CreateObject("roDateTime").AsSeconds().ToStr() + Rnd(100000).ToStr()
    callApi("GET", "/me/prefs", invalid, "onPrefs", m.generation)
    callApi("GET", "/libraries", invalid, "onLibraries", m.generation)
end sub

sub onPrefs(event as object)
    res = event.getData()
    if res.tag <> m.generation then return
    m.prefs = {}
    if res.ok and res.data <> invalid then m.prefs = res.data
    resolve()
end sub

sub onLibraries(event as object)
    res = event.getData()
    if res.tag <> m.generation then return
    if not res.ok
        showEmpty(tr("Couldn't load Home.") + " " + res.error)
        return
    end if
    m.libraries = res.data
    if m.libraries = invalid then m.libraries = []
    resolve()
end sub

sub resolve()
    if m.prefs = invalid or m.libraries = invalid then return
    m.top.action = { go: "places", places: navPlaces(m.libraries, m.prefs) }
    m.specs = resolveHomeRows(m.prefs, m.libraries, CreateObject("roDateTime"))
    m.results = []
    for i = 0 to m.specs.Count() - 1
        m.results.Push(invalid)
        callApi("GET", m.specs[i].path, invalid, "onRow", { generation: m.generation, index: i })
    end for
    m.placed = 0
    m.newContent = CreateObject("roSGNode", "ContentNode")
    m.newSizes = []
    m.newHeights = []
    if m.specs.Count() = 0 then showEmpty(tr("Nothing here yet. Add a library in Arc's settings on the web."))
end sub

' A library's Recommended rows arrive at once; they're placed as Home's are.
sub onRecommended(event as object)
    res = event.getData()
    if res.tag <> m.generation then return
    if not res.ok
        showEmpty(tr("Couldn't load Recommended.") + " " + res.error)
        return
    end if
    rows = recommendedRows(res.data, valueString(m.library.name), valueString(m.library.kind))
    m.specs = []
    m.results = []
    for each r in rows
        m.specs.Push({ title: r.title, style: r.style, continueRow: r.continueRow })
        m.results.Push(r.cards)
    end for
    m.placed = 0
    m.newContent = CreateObject("roSGNode", "ContentNode")
    m.newSizes = []
    m.newHeights = []
    if rows.Count() = 0
        showEmpty(tr("Nothing to recommend yet. Recommendations appear here once this library has titles you can watch."))
        return
    end if
    placeRows()
end sub

sub onRow(event as object)
    res = event.getData()
    if res.tag = invalid or res.tag.generation <> m.generation then return
    i = res.tag.index
    if res.ok then m.results[i] = rowItems(m.specs[i].shape, res.data) else m.results[i] = []
    placeRows()
end sub

' placeRows adds every row whose turn has come: all rows above it have answered.
sub placeRows()
    added = false
    while m.placed < m.specs.Count() and m.results[m.placed] <> invalid
        spec = m.specs[m.placed]
        cards = m.results[m.placed]
        m.placed = m.placed + 1
        if cards.Count() > 0
            row = m.newContent.createChild("ContentNode")
            row.title = spec.title
            for each card in cards
                node = row.createChild("ContentNode")
                node.addFields(cardFields())
                fillCard(node, card, spec.style)
                node.inContinue = spec.continueRow = true
            end for
            m.newSizes.Push(cardSize(spec.style))
            m.newHeights.Push(cardRowHeight(spec.style))
            added = true
        end if
    end while
    if added or m.placed = m.specs.Count() then swapIn()
end sub

' swapIn shows the rows placed so far, keeping focus where it was when Home is reloaded.
sub swapIn()
    focused = m.rows.rowItemFocused
    m.rows.rowItemSize = m.newSizes
    m.rows.rowHeights = m.newHeights
    m.rows.content = m.newContent
    m.content = m.newContent
    if m.newContent.getChildCount() = 0
        if m.placed = m.specs.Count() then showEmpty(tr("Nothing to show yet. Titles appear here once Arc has scanned your libraries."))
        return
    end if
    m.empty.visible = false
    if focused <> invalid and focused.Count() = 2 and focused[0] < m.newContent.getChildCount()
        row = m.newContent.getChild(focused[0])
        col = focused[1]
        if col >= row.getChildCount() then col = row.getChildCount() - 1
        if col < 0 then col = 0
        m.rows.jumpToRowItem = [focused[0], col]
    end if
    onFocusMoved()
end sub

sub showEmpty(text as string)
    m.empty.text = text
    m.empty.visible = true
end sub

function focusedCard() as dynamic
    f = m.rows.rowItemFocused
    if f = invalid or f.Count() < 2 or m.content = invalid then return invalid
    row = m.content.getChild(f[0])
    if row = invalid then return invalid
    return row.getChild(f[1])
end function

' The hero follows focus after a moment's rest, so scrolling along a row stays smooth.
sub onFocusMoved()
    if m.library = invalid
        y = 560
        c = focusedCard()
        ' Leave the full card and its caption on screen, using the profile's card style.
        if c <> invalid and c.inContinue then y = 1080 - cardRowHeight(c.style)
        if m.rows.translation[1] <> y then m.rows.translation = [156, y]
    end if
    m.heroDelay.control = "stop"
    m.heroDelay.control = "start"
end sub

sub showHero()
    c = focusedCard()
    if c = invalid then return
    art = c.backdrop
    overview = c.overview
    if c.spoilerEligible = true and hideSpoilers()
        art = c.safeBackdrop
        overview = ""
    end if
    m.backdrop.uri = art
    m.logo.uri = c.logo
    updateTitleVisibility()
    m.heroTitle.text = c.title
    meta = c.meta
    m.heroMeta.text = meta
    m.heroOverview.text = overview
end sub

sub onSelected()
    c = focusedCard()
    if c = invalid then return
    ' An episode opens its show's page, landing on that episode (as Plex and Arc's other apps).
    if c.kind = "episode" and c.parentId <> ""
        m.top.action = { go: "open", id: c.parentId, episodeId: c.itemId }
    else
        m.top.action = { go: "open", id: c.itemId }
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.cardPanel.visible then return true
    if key = "play"
        c = focusedCard()
        if c <> invalid and (c.kind = "movie" or c.kind = "episode")
            m.top.action = { go: "play", id: c.itemId, startMs: c.resumeMs, title: c.title, subtitle: c.line2 }
            return true
        end if
    else if key = "options"
        showMenu()
        return true
    end if
    ' Left past the first card goes on to the scene, which opens the sidebar.
    return false
end function

' --- the * menu on a card (cardmenu.bs) ---

sub showMenu()
    c = focusedCard()
    entries = cardMenu(c)
    if entries.Count() = 0 then return
    m.menuCard = c
    m.menuEntries = entries
    list = []
    for each e in entries
        list.Push({ label: e.label, detail: "" })
    end for
    m.cardPanel.title = c.title
    m.cardPanel.entries = list
    m.cardPanel.selected = -1
    m.cardPanel.visible = true
    m.cardPanel.show = true
end sub

sub onCardPicked()
    i = m.cardPanel.picked
    closeCardPanel()
    if i < 0 or i >= m.menuEntries.Count() then return
    go = runCardAction(m.menuCard, m.menuEntries[i].act)
    if go <> invalid then m.top.action = go
end sub

sub closeCardPanel()
    m.cardPanel.visible = false
    m.rows.setFocus(true)
end sub

' A card's watched or Watchlist change is saved: Home loads again (rows may change).
sub onCardChanged(event as object)
    load()
end sub

' Keep the title readable when the server's logo image is slow or unavailable.
sub updateTitleVisibility()
    m.heroTitle.visible = m.logo.uri = "" or m.logo.loadStatus <> "ready"
end sub
