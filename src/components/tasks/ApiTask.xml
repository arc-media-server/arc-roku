<?xml version="1.0" encoding="utf-8" ?>
<!-- One call to Arc's /api/v1, off the render thread. Set "request" and observe "response". -->
<component name="ApiTask" extends="Task">
    <interface>
        <!-- { method, path, body, tag, text }: tag comes back untouched for the caller; text: true
             returns the body as a string instead of parsed JSON (subtitles). -->
        <field id="request" type="assocarray" />
        <!-- { ok, status, data, error, tag } -->
        <field id="response" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/shared/http.bs" />
</component>
