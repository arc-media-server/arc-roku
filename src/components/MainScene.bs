' Where the app starts and how screens lead to each other:
'   no server        -> ServerScreen (finds Arc on the network, or takes an address)
'   no sign-in       -> SignInScreen (a code to approve from Arc's "Link a Device")
'   no profile       -> ProfilesScreen ("Who's watching?")
'   otherwise        -> HomeScreen, then DetailsScreen and PlayerScreen on top.
' Back closes the screen on top; on Home it leaves the app.

sub init()
    m.global.addFields({ hideSpoilers: true, spoilerRevision: 0, server: "", token: "", serverName: "", profile: {}, caps: {}, unauthorized: false })
    m.global.observeField("unauthorized", "onUnauthorized")
    ' Live updates
    m.global.addField("liveTopics", "assocarray", true)
    m.global.liveTopics = {}
    m.liveTask = invalid
    m.global.observeField("profile", "syncLiveUpdates")
    m.global.observeField("profile", "loadSpoilerPrefs")
    m.global.observeField("token", "syncLiveUpdates")
    m.top.observeField("visible", "syncLiveUpdates")
    m.top.observeField("visible", "loadSpoilerPrefs")
    m.screens = m.top.findNode("screens")
    m.rail = m.top.findNode("rail")
    m.rail.observeField("picked", "onRailPicked")
    m.rail.observeField("closed", "closeRail")
    m.places = []
    m.spinner = m.top.findNode("spinner")
    m.spinner.poster.uri = "pkg:/images/spinner.png"
    m.stack = []
    m.pendingLink = invalid
    m.top.findNode("queueNoticeTimer").observeField("fire", "hideQueueNotice")
    m.global.caps = deviceCaps()
    m.global.server = readSetting("server")
    m.global.serverName = readSetting("serverName")
    setToken(readSetting("token"))
    start()
end sub

sub start()
    if m.global.server = ""
        replaceAll("ServerScreen", {})
    else if m.global.token = ""
        replaceAll("SignInScreen", {})
    else
        showSpinner(true)
        callApi("GET", "/auth/status", invalid, "onStatus")
    end if
end sub

sub onStatus(event as object)
    showSpinner(false)
    res = event.getData()
    if not res.ok
        if res.status = 401
            signOutLocally()
            return
        end if
        ' Arc can't be reached: offer to try again or pick another server.
        replaceAll("ProblemScreen", { message: res.error })
        return
    end if
    s = res.data
    if s.signed_in <> true
        signOutLocally()
        return
    end if
    automaticId = readSetting("automaticProfile")
    selected = launchProfile(s, automaticId, true)
    m.hadLaunchProfile = s.profile <> invalid and s.friend <> true
    if selected = invalid
        openLaunchPicker()
    else if s.profile = invalid or selected.id <> s.profile.id
        showSpinner(true)
        callApi("POST", "/auth/profile", { id: selected.id }, "onLaunchProfile")
    else
        if s.friend <> true and selected.id = automaticId then print "Arc: signing in automatically as the saved profile"
        openLaunchHome(selected)
    end if
end sub

sub onLaunchProfile(event as object)
    res = event.getData()
    if res.ok and res.data <> invalid
        print "Arc: signing in automatically as the saved profile"
        openLaunchHome(res.data)
    else if res.status = 0 or res.status >= 500
        showSpinner(false)
        replaceAll("ProblemScreen", { message: res.error })
    else if res.status <> 401 or (res.data <> invalid and res.data.needs <> invalid)
        openLaunchPicker()
    end if
end sub

sub openLaunchPicker()
    if m.hadLaunchProfile
        showSpinner(true)
        callApi("DELETE", "/auth/profile", invalid, "onLeftLaunchProfile")
    else
        showLaunchPicker()
    end if
end sub

sub onLeftLaunchProfile(event as object)
    res = event.getData()
    if res.ok
        showLaunchPicker()
    else if res.status <> 401
        showSpinner(false)
        replaceAll("ProblemScreen", { message: res.error })
    end if
end sub

sub showLaunchPicker()
    showSpinner(false)
    m.global.profile = {}
    print "Arc: starting at Who's watching"
    replaceAll("ProfilesScreen", {})
end sub

sub openLaunchHome(profile as object)
    showSpinner(false)
    m.global.profile = profile
    replaceAll("HomeScreen", {})
    openPendingLink()
end sub

sub setToken(token as string)
    m.global.token = token
    agent = m.top.getHttpAgent()
    ' Every picture and stream the scene loads from Arc carries the sign-in.
    if token <> ""
        agent.SetHeaders({ "Authorization": "Bearer " + token })
    else
        agent.SetHeaders({})
    end if
    agent.SetCertificatesFile("common:/certs/ca-bundle.crt")
    agent.InitClientCertificates()
end sub

sub signOutLocally()
    clearSetting("token")
    clearSetting("automaticProfile")
    showSpinner(false)
    setToken("")
    m.global.profile = {}
    replaceAll("SignInScreen", {})
end sub

sub onUnauthorized()
    if m.global.unauthorized = true
        m.global.unauthorized = false
        signOutLocally()
    end if
end sub

' --- the stack of screens ---

function push(name as string, params as object) as object
    if m.stack.Count() > 0 then m.stack.Peek().visible = false
    screen = CreateObject("roSGNode", name)
    screen.params = params
    screen.observeField("action", "onAction")
    m.screens.appendChild(screen)
    fadeIn(screen)
    m.stack.Push(screen)
    screen.callFunc("takeFocus", invalid)
    updateRail()
    return screen
end function

' fadeIn: the new screen comes in over 0.2 s, as the other TV apps' page changes.
sub fadeIn(screen as object)
    if m.screenCount = invalid then m.screenCount = 0
    m.screenCount = m.screenCount + 1
    screen.id = "screen" + m.screenCount.ToStr()
    screen.opacity = 0
    fade = m.top.findNode("screenFade")
    fade.control = "stop"
    ' A fade cut short (screens opened quickly in turn) leaves the earlier screen fully shown.
    if m.fading <> invalid then m.fading.opacity = 1
    m.fading = screen
    m.top.findNode("screenFadeTo").fieldToInterp = screen.id + ".opacity"
    fade.control = "start"
end sub

sub pop()
    if m.stack.Count() = 0 then return
    screen = m.stack.Pop()
    screen.unobserveField("action")
    screen.callFunc("leaving", invalid)
    m.screens.removeChild(screen)
    if m.stack.Count() > 0
        top = m.stack.Peek()
        top.visible = true
        top.callFunc("returned", invalid)
        top.callFunc("takeFocus", invalid)
    end if
    updateRail()
end sub

sub replaceAll(name as string, params as object)
    while m.stack.Count() > 0
        pop()
    end while
    push(name, params)
end sub

sub showSpinner(on as boolean)
    m.spinner.visible = on
    if on then m.spinner.control = "start" else m.spinner.control = "stop"
end sub

' --- what screens ask for ---

sub onAction(event as object)
    a = event.getData()
    if a = invalid or a.go = invalid then return
    go = a.go
    if go = "server"
        m.global.server = a.url
        m.global.serverName = a.name
        writeSetting("server", a.url)
        writeSetting("serverName", a.name)
        replaceAll("SignInScreen", {})
    else if go = "otherServer"
        clearSetting("automaticProfile")
        clearSetting("token")
        setToken("")
        replaceAll("ServerScreen", {})
    else if go = "token"
        writeSetting("token", a.token)
        setToken(a.token)
        replaceAll("ProfilesScreen", {})
    else if go = "retry"
        start()
    else if go = "profile"
        m.global.profile = a.profile
        replaceAll("HomeScreen", {})
        openPendingLink()
    else if go = "profiles"
        m.global.profile = {}
        callApi("DELETE", "/auth/profile", invalid, "onIgnored")
        replaceAll("ProfilesScreen", {})
    else if go = "signOut"
        callApi("POST", "/auth/logout", invalid, "onIgnored")
        signOutLocally()
    else if go = "open"
        push("DetailsScreen", { id: a.id, episodeId: a.episodeId })
    else if go = "play"
        if a.queue = invalid and a.together = invalid and a.id <> invalid
            startQueue({ body: { item_ids: [a.id] }, play: a })
        else
            playTitle(a)
        end if
    else if go = "playlistPicker"
        push("PlaylistPickerScreen", { id: a.id, title: a.title })
    else if go = "playExtra"
        push("PlayerScreen", { extra: { url: a.url }, title: a.title, subtitle: a.subtitle })
    else if go = "grid"
        push("GridScreen", { title: a.title, source: a.source })
    else if go = "person"
        push("PersonScreen", { id: a.id, title: a.title })
    else if go = "search"
        push("SearchScreen", {})
    else if go = "settings"
        push("SettingsScreen", {})
    else if go = "queueAdd"
        queueAdd(a)
    else if go = "queueStart"
        startQueue(a)
    else if go = "queueEdit"
        editQueueEntry(a)
    else if go = "queueFinished"
        q = a.queue
        callApi("DELETE", playQueuePath(q.id) + "?revision=" + valueString(q.revision), invalid, "onQueueRetired")
        pop()
    else if go = "about"
        push("AboutScreen", {})
    else if go = "home"
        replaceAll("HomeScreen", {})
    else if go = "places"
        m.places = a.places
        m.rail.places = a.places
        updateRail()
    else if go = "back"
        pop()
    end if
end sub

sub playTitle(a as object)
    if a.replace = true then pop()
    push("PlayerScreen", { id: a.id, startMs: a.startMs, title: a.title, subtitle: a.subtitle, queue: a.queue, fileId: a.fileId, preroll: a.replace <> true, together: a.together })
end sub

sub refreshHomeQueue()
    if m.stack.Count() = 0 then return
    top = m.stack.Peek()
    if top.subtype() = "HomeScreen" then top.callFunc("returned", invalid)
end sub

sub onQueueRetired(event as object)
    res = event.getData()
    if res.ok or res.status = 404 then refreshHomeQueue()
end sub

sub editQueueEntry(a as object)
    if m.queueAdding = true or m.global.profile.id = invalid then return
    m.queueAdding = true
    tag = { action: a, profile: m.global.profile.id, server: m.global.server, token: m.global.token, screenId: m.stack.Peek().id, retried: false }
    callApi("GET", "/play-queues/current", invalid, "onQueueForEdit", tag)
end sub

sub onQueueForEdit(event as object)
    res = event.getData()
    tag = res.tag
    if not canStartQueue(tag)
        m.queueAdding = false
        return
    end if
    q = res.data
    a = tag.action
    if not res.ok or q = invalid or q.id <> a.queueId
        queueEditFailed()
        return
    end if
    entry = invalid
    for each candidate in visibleQueueEntries(q)
        if candidate.id = a.entryId
            entry = candidate
            exit for
        end if
    end for
    if entry = invalid
        queueEditFailed()
        return
    end if
    body = { revision: q.revision, operation: a.operation }
    if a.operation = "select"
        if entry.available <> true or entry.item = invalid
            queueEditFailed()
            return
        end if
        if q.current_entry_id = entry.id
            m.queueAdding = false
            playTitle(queuePlayAction(q, entry))
            return
        end if
        body.entry_id = entry.id
    else if a.operation = "remove"
        if q.current_entry_id = entry.id
            queueEditFailed()
            return
        end if
        body.entry_ids = [entry.id]
    else
        direction = 1
        if a.operation = "earlier" then direction = -1
        ids = reorderedQueueIds(q, entry.id, direction)
        if ids = invalid
            queueEditFailed()
            return
        end if
        body.operation = "reorder"
        body.entry_ids = ids
    end if
    callApi("PATCH", playQueuePath(q.id), body, "onQueueEntryEdited", tag)
end sub

sub onQueueEntryEdited(event as object)
    res = event.getData()
    tag = res.tag
    if not canStartQueue(tag)
        m.queueAdding = false
        return
    end if
    if res.ok and res.data <> invalid
        m.queueAdding = false
        if tag.action.operation = "select"
            entry = queueCurrent(res.data)
            if entry <> invalid
                playTitle(queuePlayAction(res.data, entry))
                return
            end if
            queueEditFailed()
        else
            refreshHomeQueue()
        end if
    else if res.status = 409 and not tag.retried
        tag.retried = true
        callApi("GET", "/play-queues/current", invalid, "onQueueForEdit", tag)
    else
        queueEditFailed()
    end if
end sub

sub queueEditFailed()
    m.queueAdding = false
    refreshHomeQueue()
    showQueueNotice(tr("Couldn't update the queue. Try again."))
end sub

sub queueAdd(a as object)
    if m.queueAdding = true or m.global.profile.id = invalid then return
    m.queueAdding = true
    tag = { id: a.id, operation: a.operation, profile: m.global.profile.id, server: m.global.server, token: m.global.token, retried: false }
    callApi("GET", "/play-queues/current", invalid, "onQueueForAdd", tag)
end sub

function queueAddHere(tag as object) as boolean
    return m.global.profile.id = tag.profile and m.global.server = tag.server and m.global.token = tag.token
end function

sub onQueueForAdd(event as object)
    res = event.getData()
    if not queueAddHere(res.tag)
        m.queueAdding = false
        return
    end if
    if res.ok and res.data <> invalid
        q = res.data
        body = { revision: q.revision, operation: res.tag.operation, item_ids: [res.tag.id] }
        callApi("PATCH", playQueuePath(q.id), body, "onQueueAdded", res.tag)
    else if res.status = 404
        callApi("POST", "/play-queues", { item_ids: [res.tag.id] }, "onQueueAdded", res.tag)
    else
        m.queueAdding = false
        showQueueNotice(tr("Couldn't update the queue. Try again."))
    end if
end sub

sub onQueueAdded(event as object)
    res = event.getData()
    m.queueAdding = false
    if not queueAddHere(res.tag) then return
    if res.ok
        refreshHomeQueue()
        if res.tag.operation = "next"
            showQueueNotice(tr("Added to play next."))
        else
            showQueueNotice(tr("Added to the queue."))
        end if
    else if (res.status = 409 or res.status = 404) and not res.tag.retried
        tag = res.tag
        tag.retried = true
        m.queueAdding = true
        callApi("GET", "/play-queues/current", invalid, "onQueueForAdd", tag)
    else
        showQueueNotice(tr("Couldn't update the queue. Try again."))
    end if
end sub

sub startQueue(a as object)
    if m.queueAdding = true or m.global.profile.id = invalid then return
    m.queueAdding = true
    tag = { request: a.body, shuffle: a.shuffle, play: a.play, retried: false, screenId: m.stack.Peek().id,
            profile: m.global.profile.id, server: m.global.server, token: m.global.token }
    callApi("GET", "/play-queues/current", invalid, "onQueueForStart", tag)
end sub

function canStartQueue(tag as object) as boolean
    return queueAddHere(tag) and m.stack.Count() > 0 and m.stack.Peek().id = tag.screenId and not m.rail.open
end function

sub onQueueForStart(event as object)
    res = event.getData()
    if not canStartQueue(res.tag)
        m.queueAdding = false
        return
    end if
    body = {}
    body.Append(res.tag.request)
    if res.ok and res.data <> invalid
        body.replace_id = res.data.id
        body.revision = res.data.revision
    else if res.status <> 404
        queueStartFailed(res.tag)
        return
    end if
    callApi("POST", "/play-queues", body, "onStartedQueue", res.tag)
end sub

sub onStartedQueue(event as object)
    res = event.getData()
    if not canStartQueue(res.tag)
        m.queueAdding = false
        return
    end if
    if res.status = 409 and not res.tag.retried
        tag = res.tag
        tag.retried = true
        callApi("GET", "/play-queues/current", invalid, "onQueueForStart", tag)
        return
    end if
    if res.ok and res.data <> invalid and res.tag.shuffle = true
        q = res.data
        body = { revision: q.revision, operation: "shuffle" }
        callApi("PATCH", playQueuePath(q.id), body, "onStartedQueueShuffled", res.tag)
        return
    end if
    playStartedQueue(res)
end sub

sub onStartedQueueShuffled(event as object)
    playStartedQueue(event.getData())
end sub

sub playStartedQueue(res as object)
    m.queueAdding = false
    if not canStartQueue(res.tag) then return
    entry = invalid
    if res.ok then entry = queueCurrent(res.data)
    if entry = invalid
        queueStartFailed(res.tag)
        return
    end if
    a = res.tag.play
    if a = invalid
        a = queuePlayAction(res.data, entry)
        a.startMs = 0
    end if
    a.queue = res.data
    playTitle(a)
end sub

sub queueStartFailed(tag as object)
    m.queueAdding = false
    if tag.play <> invalid
        ' Older servers and temporary queue failures can still play a title.
        playTitle(tag.play)
    else
        showQueueNotice(tr("Couldn't start this queue. Try again."))
    end if
end sub

sub showQueueNotice(message as string)
    m.top.findNode("queueNoticeText").text = message
    m.top.findNode("queueNotice").visible = true
    timer = m.top.findNode("queueNoticeTimer")
    timer.control = "stop"
    timer.control = "start"
end sub

sub hideQueueNotice()
    m.top.findNode("queueNotice").visible = false
end sub

sub onIgnored(event as object)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back"
        ' Back in the open sidebar leaves the app, as on the Apple TV.
        if m.rail.open then return false
        if m.stack.Count() > 1
            pop()
            return true
        end if
        ' Back on a place's first screen opens the sidebar.
        if railUsable()
            openRail()
            return true
        end if
        return false
    end if
    ' Left at a screen's edge (nothing on the screen took it) opens the sidebar.
    if key = "left" and railUsable() and not m.rail.open
        openRail()
        return true
    end if
    return false
end function

' --- the sidebar (NavRail) ---

' Screens that show the sidebar: every one but the player and the sign-in steps.
function railUsable() as boolean
    if m.places.Count() = 0 or m.stack.Count() = 0 then return false
    top = m.stack.Peek().subtype()
    for each hidden in ["PlayerScreen", "PlaylistPickerScreen", "ServerScreen", "SignInScreen", "ProfilesScreen", "ProblemScreen"]
        if top = hidden then return false
    end for
    return true
end function

sub updateRail()
    usable = railUsable()
    m.rail.visible = usable
    if not usable and m.rail.open then m.rail.open = false
    profile = m.global.profile
    if profile <> invalid and profile.name <> invalid
        m.rail.profileName = profile.name
        m.rail.profileColor = profile.color
    end if
end sub

sub openRail()
    m.rail.open = true
end sub

sub closeRail()
    m.rail.open = false
    if m.stack.Count() > 0 then m.stack.Peek().callFunc("takeFocus", invalid)
end sub

' A place opens as the first screen (Back there opens the sidebar again); the profile switches.
sub onRailPicked()
    i = m.rail.picked
    m.rail.open = false
    if i < 0
        m.global.profile = {}
        callApi("DELETE", "/auth/profile", invalid, "onIgnored")
        m.places = []
        replaceAll("ProfilesScreen", {})
        return
    end if
    if i >= m.places.Count() then return
    m.rail.current = i
    go = m.places[i].go
    if go.go = "home"
        replaceAll("HomeScreen", {})
    else if go.go = "search"
        replaceAll("SearchScreen", {})
    else if go.go = "settings"
        replaceAll("SettingsScreen", {})
    else if go.go = "grid"
        replaceAll("GridScreen", { title: go.title, source: go.source })
    else if go.go = "library"
        replaceAll("LibraryScreen", { library: go.library })
    end if
end sub

' --- deep links (Roku's search and Continue Watching launch the app with a contentId) ---

sub onLaunchArgs()
    noteLink(m.top.launchArgs)
end sub

sub onInputArgs()
    noteLink(m.top.inputArgs)
    if m.global.profile <> invalid and m.global.profile.id <> invalid then openPendingLink()
end sub

sub noteLink(args as dynamic)
    if args = invalid or args.contentId = invalid or args.contentId = "" then return
    m.pendingLink = { id: args.contentId, play: args.mediaType = "movie" or args.mediaType = "episode" }
end sub

sub openPendingLink()
    link = m.pendingLink
    if link = invalid then return
    m.pendingLink = invalid
    push("DetailsScreen", { id: link.id })
end sub

' Live updates: stop before profile/server changes; the old task owns its own connection.
sub syncLiveUpdates()
    profile = m.global.profile
    wanted = m.top.visible and m.top.liveForeground and m.global.token <> "" and profile <> invalid
    if wanted then wanted = profile.id <> invalid
    identity = ""
    if wanted then identity = m.global.server + ":" + m.global.token + ":" + profile.id
    if m.liveIdentity = identity then return
    previousIdentity = m.liveIdentity
    m.liveIdentity = identity
    if m.liveTask <> invalid
        m.liveTask.unobserveField("topics")
        m.liveTask.stopRequested = true
        m.liveCursor = m.liveTask.cursor
        m.liveCursorIdentity = previousIdentity
        m.liveTask = invalid
    end if
    if not wanted then return
    m.liveTask = CreateObject("roSGNode", "LiveEventsTask")
    m.liveTask.server = m.global.server
    m.liveTask.token = m.global.token
    if m.liveCursorIdentity = identity then m.liveTask.cursor = m.liveCursor
    m.liveTask.observeField("topics", "onLiveTopics")
    m.liveTask.catchUp = m.livePreviousIdentity = identity
    m.livePreviousIdentity = identity
    m.liveTask.control = "run"
end sub

sub onLiveTopics(event as object)
    topics = event.getData()
    if liveTouches(topics, ["profile"]) then loadSpoilerPrefs()
    m.global.liveTopics = topics
    if m.stack.Count() = 0 then return
    screen = m.stack.Peek()
    kind = screen.subtype()
    ' Grids/search/player are never reloaded while in use. They refresh on normal navigation.
    if kind = "HomeScreen" and liveTouches(topics, ["catalog", "library", "profile", "playback", "artwork"])
        screen.callFunc("returned", invalid)
    else if kind = "LibraryScreen" and liveTouches(topics, ["catalog", "library", "profile", "playback", "artwork"])
        screen.callFunc("liveRefresh", invalid)
    else if kind = "DetailsScreen" and liveTouches(topics, ["catalog", "profile", "playback", "artwork", "optimized", "previews"])
        screen.callFunc("liveRefresh", invalid)
    else if kind = "SettingsScreen" and liveTouches(topics, ["profile"])
        screen.callFunc("liveRefresh", invalid)
    end if
end sub

' Fetch once on profile selection/change or a live profile hint, never once per card.
sub loadSpoilerPrefs()
    if m.top <> invalid and m.top.visible = false then return
    m.global.spoilerRevision++
    m.global.hideSpoilers = true
    profile = m.global.profile
    if profile = invalid or profile.id = invalid or m.global.token = "" then return
    callApi("GET", "/me/prefs", invalid, "onSpoilerPrefs", { revision: m.global.spoilerRevision, profile: profile.id })
end sub

sub onSpoilerPrefs(event as object)
    res = event.getData()
    if res.tag = invalid or m.global.profile = invalid then return
    if res.tag.profile <> m.global.profile.id or res.tag.revision <> m.global.spoilerRevision then return
    if res.ok and res.data <> invalid then m.global.hideSpoilers = res.data.hide_spoilers = true
end sub
