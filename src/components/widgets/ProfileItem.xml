<?xml version="1.0" encoding="utf-8" ?>
<!-- One profile on "Who's watching?": its coloured circle with the first letter, and its name. -->
<component name="ProfileItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
    </interface>
    <children>
        <Poster id="ring" uri="pkg:/images/ring.png" width="272" height="272" translation="[4, 4]" opacity="0" />
        <Poster id="avatar" width="240" height="240" translation="[20, 20]" />
        <Label id="letter" width="240" height="240" translation="[20, 20]" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="96" />
        </Label>
        <Label id="name" width="280" horizAlign="center" translation="[0, 296]" font="font:MediumSystemFont" color="0x9AA7A7FF" />
        <Label id="lock" width="280" horizAlign="center" translation="[0, 344]" font="font:SmallestSystemFont" color="0x9AA7A7FF" />
    </children>
</component>
