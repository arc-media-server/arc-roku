sub init()
    m.back = m.top.findNode("back")
    m.pills = m.top.findNode("pills")
    m.focus = 0
    m.top.observeField("focusedChild", "paint")
end sub

' One capsule and label per pill, each as wide as its name.
sub build()
    m.pills.removeChildrenIndex(m.pills.getChildCount(), 0)
    m.items = []
    x = 0
    for each text in m.top.labels
        g = m.pills.createChild("Group")
        g.translation = [x, 0]
        cap = g.createChild("Capsule")
        cap.height = 68
        label = g.createChild("Label")
        label.font = "font:SmallBoldSystemFont"
        label.text = text
        w = label.boundingRect().width
        if w <= 0 then w = Len(text) * 17
        w = w + 64
        label.width = w
        label.height = 68
        label.horizAlign = "center"
        label.vertAlign = "center"
        cap.width = w
        m.items.Push({ cap: cap, label: label })
        x = x + w + 6
    end for
    m.back.width = x - 6 + 16
    m.focus = m.top.selected
    paint()
end sub

sub paint()
    if m.items = invalid then return
    focused = m.top.isInFocusChain()
    ' Coming back to the bar starts on the chosen pill.
    if focused and m.had <> true then m.focus = m.top.selected
    m.had = focused
    for i = 0 to m.items.Count() - 1
        it = m.items[i]
        chosen = i = m.top.selected
        if focused and i = m.focus
            it.cap.visible = true
            it.cap.color = "0xFFFFFFFF"
            it.label.color = "0x000000FF"
        else if chosen
            it.cap.visible = true
            if focused then it.cap.color = "0xB8BCBEFF" else it.cap.color = "0xFFFFFFFF"
            it.label.color = "0x000000FF"
        else
            it.cap.visible = false
            it.label.color = "0xF5F5F7FF"
        end if
    end for
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.items = invalid then return false
    if key = "right" and m.focus < m.items.Count() - 1
        m.focus = m.focus + 1
        paint()
        if m.top.followFocus then m.top.picked = m.focus
        return true
    else if key = "left" and m.focus > 0
        m.focus = m.focus - 1
        paint()
        if m.top.followFocus then m.top.picked = m.focus
        return true
    else if key = "OK"
        m.top.picked = m.focus
        return true
    else if key = "down"
        m.top.leave = true
        return true
    end if
    ' Left from the first pill goes on to the scene, which opens the sidebar.
    return false
end function
