sub init()
    m.global.observeField("hideSpoilers", "onContent")
    m.edge = m.top.findNode("edge")
    m.card = m.top.findNode("card")
    m.frame = m.top.findNode("frame")
    m.blank = m.top.findNode("blank")
    m.picture = m.top.findNode("picture")
    m.track = m.top.findNode("track")
    m.bar = m.top.findNode("bar")
    m.strip = m.top.findNode("strip")
    m.play = m.top.findNode("play")
    m.left = m.top.findNode("left")
    m.tick = m.top.findNode("tick")
    m.line1 = m.top.findNode("line1")
    m.line2 = m.top.findNode("line2")
    m.overview = m.top.findNode("overview")
    m.shade = m.top.findNode("shade")
    m.logo = m.top.findNode("logo")
    m.logoTitle = m.top.findNode("logoTitle")
    m.ring = m.top.findNode("ring")
    m.round = m.top.findNode("round")
    m.roundBlank = m.top.findNode("roundBlank")
    m.face = m.top.findNode("face")
    m.picture.setHttpAgent(m.top.getScene().getHttpAgent())
    m.face.setHttpAgent(m.top.getScene().getHttpAgent())
    m.logo.setHttpAgent(m.top.getScene().getHttpAgent())
end sub

sub onContent()
    c = m.top.itemContent
    if c = invalid
        m.overview.visible = false
        return
    end if
    art = c.HDPosterUrl
    spoilersHidden = c.spoilerEligible = true and hideSpoilers()
    if spoilersHidden then art = c.safeArt
    m.overview.visible = c.showOverview = true and not spoilersHidden and c.overview <> ""
    if m.overview.visible then m.overview.text = c.overview else m.overview.text = ""
    m.picture.opacity = 1
    m.blank.opacity = 1
    if c.available = false
        m.picture.opacity = 0.45
        m.blank.opacity = 0.45
    end if
    m.line1.text = c.title
    m.line2.text = c.line2
    backdrop = c.style = "backdrop"
    if backdrop then m.logo.uri = c.logo else m.logo.uri = ""
    m.logoTitle.text = c.title
    layout()
    if c.style = "named" then m.face.uri = art else m.picture.uri = art
end sub

' The picture's height comes from its style (cardPicture in cards.bs); the two lines go under it
' when the slot leaves room for them (cardSize does).
' The card's room on either side of it in its slot: cardPad in cards.bs, which the lists use.
const PAD = 14
' How much a focused card grows, as arc-tv's (which grow 8%, with more room around them).
const ZOOM = 0.06

sub layout()
    c = m.top.itemContent
    w = m.top.width - 2 * PAD
    h = m.top.height
    if w <= 0 or h <= 0 then return
    topInset = 0
    if c <> invalid and c.topInset <> invalid then topInset = c.topInset
    m.card.translation = [PAD, topInset]
    ' "named" (people): a poster with the name and role under it.
    named = c <> invalid and c.style = "named"
    thumb = c <> invalid and (c.style = "thumb" or named)
    backdrop = c <> invalid and c.style = "backdrop"
    ph = Int(w * 3 / 2)
    if thumb then ph = Int(w * 9 / 16)
    if backdrop then ph = Int(w * 3 / 4)
    if named then ph = w
    if ph > h then ph = h
    ' A person: a round picture as wide as the card, the name and role under it.
    m.round.visible = named
    m.ring.visible = named
    m.frame.visible = not named
    if named
        m.round.maskSize = [w, w]
        for each n in [m.roundBlank, m.face]
            n.width = w
            n.height = w
        end for
        ' Let scaleToZoom crop the original portrait into the circle.
        ' Draw the ring inside the portrait so the focused card fits within its row.
        m.ring.width = w
        m.ring.height = w
    end if
    for each n in [m.blank, m.picture]
        n.width = w
        n.height = ph
    end for
    if backdrop
        ' Keep the source ratio. The simulator stretches to loadWidth and loadHeight before
        ' scaleToZoom can crop, which squashes wide artwork in this 4:3 frame.
        m.picture.loadWidth = 0
        m.picture.loadHeight = 0
    else
        m.picture.loadWidth = w
        m.picture.loadHeight = ph
    end if
    m.frame.maskSize = [w, ph]
    if ph > w
        m.frame.maskUri = "pkg:/images/mask-poster.png"
    else if backdrop
        m.frame.maskUri = "pkg:/images/mask-backdrop.png"
    else
        m.frame.maskUri = "pkg:/images/mask-thumb.png"
    end if
    ' A Backdrop's logo sits low and centred, 72% across, as arc-tv's, clear of the progress bar;
    ' without a logo, the title. (No loadWidth: the simulator would stretch the logo to it.)
    m.shade.visible = backdrop
    m.logo.visible = backdrop and m.logo.uri <> ""
    m.logoTitle.visible = backdrop and m.logo.uri = ""
    if backdrop
        m.shade.translation = [0, ph / 2]
        m.shade.width = w
        m.shade.height = ph / 2
        lw = Int(w * 0.72)
        lh = Int(ph * 0.26)
        m.logo.translation = [(w - lw) / 2, ph - 40 - lh]
        m.logo.width = lw
        m.logo.height = lh
        m.logoTitle.translation = [24, ph - 40 - 90]
        m.logoTitle.width = w - 48
        m.logoTitle.height = 90
    end if
    m.edge.width = w
    m.edge.height = ph
    m.card.scaleRotateCenter = [w / 2, ph / 2]
    ' Every card has its caption when its slot leaves room for it.
    caption = h >= ph + 60
    m.line1.visible = caption
    m.line2.visible = caption and m.line2.text <> ""
    captionAlign = "center"
    if c <> invalid and c.showOverview = true then captionAlign = "left"
    m.line1.horizAlign = captionAlign
    m.line2.horizAlign = captionAlign
    m.line1.translation = [0, ph + 14]
    m.line1.width = w
    m.line2.translation = [0, ph + 50]
    m.line2.width = w
    m.overview.translation = [0, ph + 86]
    m.overview.width = w
    progress = 0.0
    if c <> invalid then progress = c.progress
    m.track.visible = progress > 0
    m.bar.visible = progress > 0
    ' A 16:9 picture gets the resume strip: a shade along the bottom, a play mark, a short bar
    ' and the minutes left. Posters and Backdrops keep a thin bar across the bottom.
    strip = progress > 0 and thumb and not named
    m.strip.visible = strip
    m.play.visible = strip
    m.left.visible = strip
    if strip then m.track.color = "0xFFFFFF59" else m.track.color = "0x00000099"
    if strip
        m.strip.translation = [0, ph - 96]
        m.strip.width = w
        m.strip.height = 96
        m.play.translation = [18, ph - 38]
        m.track.translation = [52, ph - 29]
        m.track.width = 120
        m.track.height = 5
        m.bar.translation = [52, ph - 29]
        m.bar.width = 120 * progress
        m.bar.height = 5
        m.left.text = cardStripText(c.leftMin)
        m.left.translation = [186, ph - 44]
        m.left.width = w - 200
        m.left.height = 34
        m.left.vertAlign = "center"
    else if progress > 0
        m.track.translation = [16, ph - 22]
        m.track.width = w - 32
        m.track.height = 8
        m.bar.translation = [16, ph - 22]
        m.bar.width = (w - 32) * progress
        m.bar.height = 8
    end if
    m.tick.visible = c <> invalid and c.played = true and progress = 0
    m.tick.translation = [w - 52, 12]
end sub

sub onFocus()
    c = m.top.itemContent
    focus = m.top.focusPercent
    if m.top.itemHasFocus then focus = 1
    if not m.top.rowListHasFocus or not m.top.gridHasFocus then focus = 0
    grow = 1 + ZOOM * focus
    m.card.scale = [grow, grow]
    if c <> invalid and c.style = "named"
        m.ring.opacity = focus
        m.edge.opacity = 0
        return
    end if
    m.edge.opacity = focus
end sub
