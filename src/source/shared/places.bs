' The places in the sidebar, as the Apple TV app's: Search, Home, the libraries in the profile's
' order with the Watchlist where the profile put it (prefs.watchlist_position: how many libraries
' come before it), Playlists and Settings. Each has an id, a label, an icon
' (pkg:/images/nav/<icon>.png) and the action that opens it as the first screen.
function navPlaces(libraries as object, prefs as dynamic) as object
    places = [
        { id: "search", label: tr("Search"), icon: "search", go: { go: "search" } },
        { id: "home", label: tr("Home"), icon: "home", go: { go: "home" } }
    ]
    libs = orderLibraries(libraries, prefs)
    watchlistAt = 0
    if prefs <> invalid and prefs.watchlist_position <> invalid then watchlistAt = prefs.watchlist_position
    if watchlistAt < 0 then watchlistAt = 0
    if watchlistAt > libs.Count() then watchlistAt = libs.Count()
    watchlist = { id: "watchlist", label: tr("Watchlist"), icon: "watchlist", go: { go: "grid", title: tr("Watchlist"), source: { kind: "watchlist" } } }
    for i = 0 to libs.Count() - 1
        if i = watchlistAt then places.Push(watchlist)
        lib = libs[i]
        places.Push({ id: "library:" + lib.id.ToStr(), label: lib.name, icon: libraryIcon(lib.kind),
            go: { go: "library", library: { id: lib.id, name: lib.name, kind: lib.kind } } })
    end for
    if watchlistAt >= libs.Count() then places.Push(watchlist)
    places.Push({ id: "playlists", label: tr("Playlists"), icon: "playlists", go: { go: "grid", title: tr("Playlists"), source: { kind: "playlists" } } })
    places.Push({ id: "queue", label: tr("Queue"), icon: "playlists", go: { go: "queue" } })
    places.Push({ id: "settings", label: tr("Settings"), icon: "settings", go: { go: "settings" } })
    return places
end function

function libraryIcon(kind as dynamic) as string
    if kind = "shows" then return "tv"
    if kind = "videos" then return "videos"
    return "movies"
end function

' placeIndex: where the place with `id` is in `places`, or -1.
function placeIndex(places as object, id as string) as integer
    for i = 0 to places.Count() - 1
        if places[i].id = id then return i
    end for
    return -1
end function
