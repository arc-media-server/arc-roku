' Turning Arc's titles into the ContentNodes rows and grids show, choosing artwork as the web's
' PosterCard and EpisodeCard do.

' cardFields: what a card carries besides its picture and title.
' cardPad: the room left on either side of a card in its row or grid slot, so the card can zoom
' and show its focus ring without the list clipping it (CardItem draws inside it).
function cardPad() as integer
    return 14
end function

' cardSlot: the slot a card of w x h takes in a row list or grid.
function cardSlot(w as integer, h as integer) as object
    return [w + 2 * cardPad(), h]
end function

' The picture and caption sizes for each card style, so every row, grid and the card itself agree:
' posters 220 x 330, 16:9 pictures 400 x 225, Backdrops 400 x 300 (arc-tv's 4:3 "Arc" look), and
' people's round pictures 220 across. Each has two lines under it (the title, then the year, the
' episode or what the row says), which need cardCaption() below the picture.
function cardCaption() as integer
    return 80
end function

function cardPicture(style as string) as object
    if style = "thumb" then return [400, 225]
    if style = "backdrop" then return [400, 300]
    if style = "named" then return [220, 220]
    return [220, 330]
end function

' cardSize: the slot a card of this style takes in a row or grid, its caption included.
function cardSize(style as string) as object
    pic = cardPicture(style)
    h = pic[1] + cardCaption()
    if h < 330 then h = 330
    return cardSlot(pic[0], h)
end function

' cardRowHeight: a row of these cards with its title above them.
function cardRowHeight(style as string) as integer
    slot = cardSize(style)
    return slot[1] + 70
end function

function cardFields() as object
    return { available: true, spoilerEligible: false, safeArt: "", safeBackdrop: "", itemId: "", kind: "", parentId: "", line2: "", progress: 0.0, style: "poster", backdrop: "", logo: "", meta: "", overview: "", showOverview: false, topInset: 0, resumeMs: 0, played: false, path: "", watchlisted: false, leftMin: 0, inContinue: false }
end function

' fillCard sets a ContentNode (with cardFields) for an item shown as "poster", "thumb" or
' "backdrop" (the title's background art with its logo on it, the web's Backdrops look).
sub fillCard(node as object, card as object, style as string, seasonPosters = invalid as dynamic)
    it = card.item
    img = it.images
    if img = invalid then img = {}
    ep = it.kind = "episode"
    poster = img.primary
    episodePoster = img.series_primary
    if seasonPosters = true and img.season_primary <> invalid and img.season_primary <> "" then episodePoster = img.season_primary
    if ep and episodePoster <> invalid and episodePoster <> "" then poster = episodePoster
    if seasonPosters <> false and card.season <> invalid and card.seasonPoster <> invalid and card.seasonPoster <> "" then poster = card.seasonPoster
    thumb = img.backdrop
    if thumb = invalid then thumb = img.primary
    if ep
        thumb = img.primary
        if thumb = invalid then thumb = img.series_backdrop
    end if
    backdrop = img.backdrop
    if ep then backdrop = img.series_backdrop
    if backdrop = invalid then backdrop = img.primary
    logo = img.logo
    if ep then logo = img.series_logo

    node.itemId = valueOr(it.id, "")
    node.spoilerEligible = spoilerEligible(it)
    safeEpisode = imageUrl(safeEpisodeArt(it))
    node.safeArt = safeEpisode
    node.safeBackdrop = fullImage(safeEpisode)
    ' Season and show posters can still be shown while the episode still is hidden.
    if ep and style = "poster" and seasonPosters = true and episodePoster <> invalid and episodePoster <> ""
        node.safeArt = imageUrl(episodePoster)
    end if
    node.available = it.available <> false
    node.kind = it.kind
    if it.path <> invalid then node.path = it.path
    if it.parent_id <> invalid then node.parentId = it.parent_id
    node.style = style
    if style = "thumb"
        node.HDPosterUrl = imageUrl(thumb)
    else if style = "backdrop"
        node.HDPosterUrl = imageUrl(backdrop)
    else
        node.HDPosterUrl = imageUrl(poster)
    end if
    node.backdrop = fullImage(imageUrl(backdrop))
    node.logo = imageUrl(logo)
    node.overview = valueOr(it.overview, "")
    node.meta = metaLine(it)
    node.resumeMs = resumeMs(it)
    node.played = it.user_data <> invalid and it.user_data.played = true
    node.watchlisted = it.user_data <> invalid and it.user_data.watchlisted = true

    title = it.title
    subText = ""
    if ep
        if it.series_title <> invalid then title = it.series_title
        ' Only the number under the show's name: the episode's title never shares the line.
        subText = episodeCode(it)
    else if card.season <> invalid
        subText = tr("Season %1").Replace("%1", card.season.ToStr())
        if card.episodes <> invalid and card.episodes > 1 then subText = subText + " · " + tr("%1 new episodes").Replace("%1", card.episodes.ToStr())
    else
        subText = yearAndEdition(it)
    end if
    if card.line2 <> invalid then subText = card.line2
    node.title = title
    node.line2 = subText
    d = durationMs(it)
    r = node.resumeMs
    if r > 0 and d > 0
        p = r / d
        if p < 0.02 then p = 0.02
        if p > 1 then p = 1
        node.progress = p
        node.leftMin = minutesLeft(r, d)
    end if
end sub

' fullImage asks Arc for a backdrop's full-resolution picture, for full-screen backgrounds.
function fullImage(url as string) as string
    if url = "" then return ""
    if url.Instr("?") >= 0 then return url + "&size=full"
    return url + "?size=full"
end function

function valueOr(v as dynamic, fallback as dynamic) as dynamic
    if v = invalid then return fallback
    return v
end function
